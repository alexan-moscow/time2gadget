<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ ЦВЕТА (docs/DESIGN-SYSTEM.md → Цвета) ============ -->
    <Color x:Key="Color.Background">#0E1420</Color>
    <Color x:Key="Color.SurfaceSector">#1C2433</Color>
    <Color x:Key="Color.SurfaceSectorHover">#26314A</Color>
    <Color x:Key="Color.Accent">#3D8BFF</Color>
    <Color x:Key="Color.AccentHover">#5C9EFF</Color>
    <Color x:Key="Color.TextPrimary">#F5F7FA</Color>
    <Color x:Key="Color.TextSecondary">#8CA0BE</Color>
    <Color x:Key="Color.BorderSubtle">#2A3547</Color>
    <Color x:Key="Color.Finish">#FF6B4A</Color>

