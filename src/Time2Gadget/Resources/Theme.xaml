    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.SurfaceSector" Color="{StaticResource Color.SurfaceSector}" Opacity="0.7" />
    <SolidColorBrush x:Key="Brush.SurfaceSectorHover" Color="{StaticResource Color.SurfaceSectorHover}" Opacity="0.85" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" Opacity="0.6" />
    <SolidColorBrush x:Key="Brush.Finish" Color="{StaticResource Color.Finish}" />
    <!-- Кнопка автозакрытия в режиме «свернуть в трей / закрыть» — приглушённый красный (докладка 2026-09-28). -->
    <SolidColorBrush x:Key="Brush.AutoClose" Color="#B5574F" />
    <SolidColorBrush x:Key="Brush.ButtonSurface" Color="{StaticResource Color.SurfaceSector}" Opacity="0.55" />

    <!-- Обновления (2026-09-27): жёлтый — «есть что-то новое», не тревога (красный занят завершением таймера). -->
    <Color x:Key="Color.UpdateAccent">#FFC940</Color>
    <SolidColorBrush x:Key="Brush.UpdateAccent" Color="{StaticResource Color.UpdateAccent}" />
    <SolidColorBrush x:Key="Brush.UpdateBannerBackground" Color="{StaticResource Color.UpdateAccent}" Opacity="0.12" />

    <!-- ============ ТИПОГРАФИКА (docs/DESIGN-SYSTEM.md → Типографика) ============ -->
    <FontFamily x:Key="Font.Primary">Segoe UI Variable, Segoe UI</FontFamily>

    <Style x:Key="Style.TimeDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Style.TimeDisplayCompact" TargetType="TextBlock" BasedOn="{StaticResource Style.TimeDisplay}">
        <Setter Property="FontSize" Value="30" />
    </Style>

    <!-- ============ Сегментный циферблат (LCD-стиль, докладка 2026-09-27; референс — электронные часы
         с видимыми погасшими сегментами). Шрифт DSEG7 Classic встроен в сборку (Assets/Fonts, SIL OFL 1.1).
         Два слоя в одной ячейке: «подложка» 88:88 цветом Color.SegmentGhost + горящие цифры поверх —
         см. Converters/SegmentTimeConverter.cs. ============ -->
    <Color x:Key="Color.SegmentGhost">#222E47</Color>
    <SolidColorBrush x:Key="Brush.SegmentGhost" Color="{StaticResource Color.SegmentGhost}" />
    <!-- Цвет подложки на циферблате: пока эффект закрашивает циферблат, MainWindow подменяет его прозрачным
         (докладка 2026-09-28) — видны только горящие цифры, тёмные «88» не торчат из заливки. -->
    <SolidColorBrush x:Key="Brush.SegmentGhostLive" Color="{StaticResource Color.SegmentGhost}" />
    <FontFamily x:Key="Font.Segment">pack://application:,,,/Assets/Fonts/#DSEG7 Classic</FontFamily>

    <Style x:Key="Style.SegmentDigits" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Segment}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="Style.SegmentGhost" TargetType="TextBlock" BasedOn="{StaticResource Style.SegmentDigits}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.SegmentGhostLive}" />
    </Style>

    <!-- Часы — тем же сегментным шрифтом, что главный таймер, мельче и приглушённее (вторичная информация).
         DSEG моноширинный: секунды не сдвигают строку. -->
    <Style x:Key="Style.ClockText" TargetType="TextBlock" BasedOn="{StaticResource Style.SegmentDigits}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Style.ClockGhost" TargetType="TextBlock" BasedOn="{StaticResource Style.ClockText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.SegmentGhostLive}" />
    </Style>

    <Style x:Key="Style.StatusLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Дата под часами — тем же шрифтом, что «ГОТОВО/ОСТАЛОСЬ» (докладка 2026-09-27). -->
    <Style x:Key="Style.DateText" TargetType="TextBlock" BasedOn="{StaticResource Style.StatusLabel}" />

    <!-- Тонкий разделитель между таймером со статусом и часами/датой (видим, если включено хоть одно). -->
    <Style x:Key="Style.ClockSeparator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.BorderSubtle}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Число НЕ участвует в радиус-привязанном Viewbox-масштабировании (см. SectorRingControl.xaml.cs) —
         только подпись "МИН" ужимается под доступное место; число держит свой размер, докладка 2026-09-27
         (пользователь: "МИН — норм, а цифры стали слишком мелкие"). -->
    <!-- Только число в секторе, без подписи "МИН" (убрали совсем, докладка 2026-09-27 — теснота
         24px-кольца не позволяла держать крупную цифру И читаемую подпись одновременно). Число —
         в Viewbox по всей площади сектора (см. SectorRingControl.xaml.cs), поэтому базовый
         FontSize здесь — не более чем "дизайновый" ориентир, реальный размер даёт Viewbox. -->
    <Style x:Key="Style.SectorValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <!-- ============ КРУГЛЫЕ КНОПКИ УПРАВЛЕНИЯ (docs/COMPONENTS.md → CircleButtonStyle) ============ -->
    <Style x:Key="Style.CircleButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.ButtonSurface}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource Brush.SurfaceSectorHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.PrimaryCircleButton" TargetType="Button" BasedOn="{StaticResource Style.CircleButton}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource Brush.AccentHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Прямоугольные кнопки компакта (докладка 2026-09-27: ниже круглых — больше места под
         крупные часы/таймер). Те же цвета и подсветка, что у круглых; иконки — те же Path. ============ -->
    <Style x:Key="Style.RectButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.ButtonSurface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceSectorHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.PrimaryRectButton" TargetType="Button" BasedOn="{StaticResource Style.RectButton}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.AccentHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Угловые иконки-кнопки (шестерёнка/крестик) — docs/UI-CONTRACT.md ============ -->
    <Style x:Key="Style.CornerIconButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource Brush.SurfaceSectorHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Тонкий ВЕРТИКАЛЬНЫЙ слайдер громкости — слева от кнопки Mute, высотой с кнопку
         (докладка 2026-09-27: раньше был горизонтальным под кнопкой, «громкость пропала» — на самом
         деле не помещалась в новую компоновку рядов; сделан минималистичный вертикальный вариант). ==== -->
    <Style x:Key="Style.ThinVolumeSliderVertical" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Width="3" CornerRadius="1.5" Background="{StaticResource Brush.BorderSubtle}" HorizontalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Width="3" CornerRadius="1.5" Background="{StaticResource Brush.Accent}" HorizontalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.TextPrimary}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Всплывающие подсказки (Controls/HintService.cs, docs/UI-CONTRACT.md → Подсказки).
         Минималистичный «пузырь»: фон окна, тонкая рамка с переходом от акцента к нейтральной,
         мягкая тень. Margin оставляет место под тень внутри прозрачного Popup. ============ -->
    <Style x:Key="Style.HintBubble" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Background}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Color.Accent}" Offset="0" />
                    <GradientStop Color="{StaticResource Color.BorderSubtle}" Offset="0.85" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="MaxWidth" Value="260" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="10" ShadowDepth="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.HintText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="15" />
    </Style>

    <!-- Стандартные подсказки (окно настроек и меню) — тот же вид, что у подсказок главного окна (2026-09-28:
         в настройках были системные белые). Окно у края экрана — WPF сам переносит ToolTip в видимую область. -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Style="{StaticResource Style.HintBubble}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Style.HintText}" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Тёмная тема для стандартных контролов SettingsWindow (docs/UI-CONTRACT.md).
         Без x:Key — применяются автоматически ко всем контролам этого типа; MainWindow's Button'ы
         уже имеют явные Style (выше приоритетом), поэтому эти defaults их не затрагивают. ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    </Style>

    <Style x:Key="Style.SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- SystemColors-переопределение НЕ работает на .NET 8 (современная тема ComboBox не читает
         классические SystemColors-ключи для попапа) — подтверждено скриншотом, докладка 2026-09-27.
         Полный retemplate ComboBox — единственный надёжный способ. ВАЖНО: ContentPresenter для
         закрытого состояния обязан биндиться на SelectionBoxItem/SelectionBoxItemTemplate именно
         так, как ниже — иначе показывает сырой ToString() объекта вместо DisplayMemberPath-значения
         (наступили на это в первой попытке). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource Brush.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /> <!-- ▶ в строке звонка — у правого края -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceSectorHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceSector}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вертикальная полоса прокрутки (докладка 2026-09-28): на ~30% уже системной (12 вместо 17px), тёмная, без стрелок —
         окно настроек, выпадающие списки, всплывашки быстрых таймеров. Горизонтальная — системная. -->
    <Style x:Key="Style.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Background="{StaticResource Brush.BorderSubtle}" Margin="3,2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12" />
                <Setter Property="MinWidth" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Style.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Style.ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Style.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceSector}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleBtn" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource Brush.TextSecondary}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.BorderSubtle}"
                                    BorderThickness="1" CornerRadius="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    MaxHeight="340" Margin="0,2,0,0">
                                <!-- Плавная прокрутка: построчная оставляла внизу пустую «строку» после последнего пункта. -->
                                <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceSector}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Style.SettingsButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceSector}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,4" />
        <!-- Свой шаблон: стандартный рисовал системную светло-голубую подсветку при наведении/нажатии,
             выпадавшую из тёмной темы (заметили на «Проверить обновления», 2026-09-27). -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceSectorHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.LinkButton" TargetType="Button" BasedOn="{StaticResource Style.SettingsButton}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
