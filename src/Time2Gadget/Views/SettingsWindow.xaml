<Window x:Class="Time2Gadget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:c="clr-namespace:Time2Gadget.Controls"
        xmlns:vm="clr-namespace:Time2Gadget.ViewModels"
        mc:Ignorable="d"
        Title="Настройки — Тайм2гаджет"
        Width="380" Height="620"
        Background="{StaticResource Brush.Background}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>

        <!-- Пункт списка эффектов: название и ▶/■ просмотра (в выпадающем списке — только в раскрытом, не у «Отключено»). -->
        <DataTemplate x:Key="Template.EffectComboItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource Style.EffectPreviewButton}" Padding="8,1" FontSize="11" Margin="10,0,0,0"
                        PreviewMouseLeftButtonDown="OnEffectPreviewMouseDown" PreviewMouseLeftButtonUp="OnRingtonePreviewMouseUp">
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource RingtonePreviewVisibility}">
                            <Binding RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                            <Binding Path="CanPreview" />
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="20,10,20,20">
        <StackPanel>

            <!-- ============ Автозагрузка / закрытие ============ -->
            <TextBlock Text="Запуск и закрытие" Style="{StaticResource Style.SectionHeader}" Margin="0,0,0,8" />
            <CheckBox ToolTip="Запускать таймер при входе в Windows" Content="Запускать вместе с Windows" IsChecked="{Binding IsLaunchAtStartup}" />
            <CheckBox ToolTip="Окно таймера поверх других окон" Content="Поверх всех окон после запуска" IsChecked="{Binding IsAlwaysOnTop}" />

            <TextBlock Text="При закрытии окна:" Margin="0,10,0,4" />
            <ComboBox ToolTip="Что делает крестик в окне таймера" ItemsSource="{Binding CloseBehaviorOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding CloseBehavior}" />

            <!-- ============ Звук ============ -->
            <TextBlock Text="Звук" Style="{StaticResource Style.SectionHeader}" />

            <TextBlock Text="Устройство вывода:" Margin="0,0,0,4" />
            <ComboBox ToolTip="Куда выводить звонок" ItemsSource="{Binding AudioDevices}" DisplayMemberPath="FriendlyName"
                      SelectedItem="{Binding SelectedAudioDevice}" />

            <TextBlock Text="Громкость по умолчанию:" Margin="0,10,0,2" />
            <Slider ToolTip="Громкость звонка" Minimum="0" Maximum="1" Value="{Binding AlarmVolume}" TickFrequency="0.05" IsSnapToTickEnabled="True" />

            <TextBlock Text="Звонок:" Margin="0,10,0,4" />
            <!-- В каждой строке раскрытого списка — ▶: слушать звонок прямо в списке, не выбирая его
                 (докладка 2026-09-27). В закрытом поле ▶ не показывается (там кнопка всё равно не нажимается). -->
            <ComboBox ToolTip="Звонок по окончании таймера; ▶ в списке — прослушать" ItemsSource="{Binding RingtoneOptions}" SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedRingtoneId}" DropDownClosed="OnRingtoneDropDownClosed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel.Visibility>
                                    <MultiBinding Converter="{StaticResource RingtonePreviewVisibility}">
                                        <Binding RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                                        <Binding Path="CanPreview" />
                                    </MultiBinding>
                                </StackPanel.Visibility>
                                <TextBlock Text="{Binding DurationText}" Style="{StaticResource Style.SoundDuration}" />
                                <Button Style="{StaticResource Style.PreviewButton}" Tag="{Binding Id}" Padding="8,1" FontSize="11"
                                        PreviewMouseLeftButtonDown="OnRingtonePreviewMouseDown"
                                        PreviewMouseLeftButtonUp="OnRingtonePreviewMouseUp" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding IsCustomRingtoneSelected, Converter={StaticResource BoolToVis}}">
                <Button ToolTip="Выбрать свой файл (.mp3, .wav) — он копируется к программе" Content="Обзор" Style="{StaticResource Style.SettingsButton}" Command="{Binding BrowseCustomSoundCommand}" />
                <TextBlock Text="{Binding CustomSoundFilePath}" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="200" />
            </StackPanel>

            <!-- Повторное нажатие гасит звук с затуханием (докладка 2026-09-28). -->
            <Button ToolTip="Прослушать выбранный звонок; повторно — стоп" Command="{Binding PreviewRingtoneCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" MinWidth="120">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Style.SettingsButton}">
                        <Setter Property="Content" Value="▶ Прослушать" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewPlaying}" Value="True">
                                <Setter Property="Content" Value="■ Стоп" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ============ Поведение при завершении ============ -->
            <TextBlock Text="Поведение таймера при завершении" Style="{StaticResource Style.SectionHeader}" />

            <TextBlock Text="{Binding AlarmRepeatCount, StringFormat='Сколько раз звонить: {0}'}" Margin="0,0,0,2" />
            <Slider ToolTip="Сколько раз проиграть звонок" Minimum="1" Maximum="10" Value="{Binding AlarmRepeatCount}" TickFrequency="1" IsSnapToTickEnabled="True" />

            <!-- ============ Визуальные эффекты ============ -->
            <TextBlock Text="Визуальный эффект во время отсчёта" Style="{StaticResource Style.SectionHeader}" />
            <!-- ▶ в раскрытом списке — показать эффект на циферблате; закрытие списка/выбор прекращает показ (2026-09-28). -->
            <ComboBox ToolTip="Эффект циферблата во время отсчёта; ▶ в списке — показать" ItemsSource="{Binding RunningEffectOptions}" SelectedValuePath="Value" SelectedValue="{Binding RunningEffect}"
                      ItemTemplate="{StaticResource Template.EffectComboItem}" DropDownClosed="OnEffectDropDownClosed" />

            <TextBlock Text="Визуальный эффект при завершении" Style="{StaticResource Style.SectionHeader}" />
            <ComboBox ToolTip="Эффект циферблата и трея по окончании; ▶ в списке — показать" ItemsSource="{Binding FinishEffectOptions}" SelectedValuePath="Value" SelectedValue="{Binding FinishEffect}"
                      ItemTemplate="{StaticResource Template.EffectComboItem}" DropDownClosed="OnEffectDropDownClosed" />
            <!-- Шкала 2 с … 5 мин и последним шагом «бесконечно» (MainViewModel.FinishEffectDurationSteps);
                 действует и на окно, и на трей. -->
            <TextBlock Text="{Binding FinishEffectDurationLabel}" Margin="0,10,0,2" />
            <Slider ToolTip="Сколько длится эффект по окончании" Minimum="0" Maximum="{Binding FinishEffectDurationMaxIndex, Mode=OneWay}"
                    Value="{Binding FinishEffectDurationIndex}" TickFrequency="1" IsSnapToTickEnabled="True" />

            <!-- ============ Размер видов — отдельно полный и компактный (докладка 2026-09-27) ============ -->
            <TextBlock Text="Размер" Style="{StaticResource Style.SectionHeader}" />
            <TextBlock Text="{Binding FullViewScaleLabel}" Margin="0,0,0,2" />
            <Slider ToolTip="Размер полного вида" Minimum="0.6" Maximum="1.6" Value="{Binding FullViewScale}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding CompactViewScaleLabel}" Margin="0,10,0,2" />
            <Slider ToolTip="Размер компактного вида" Minimum="0.6" Maximum="1.6" Value="{Binding CompactViewScale}" TickFrequency="0.05" IsSnapToTickEnabled="True" />

            <!-- ============ Часы под статусом ============ -->
            <TextBlock Text="Часы" Style="{StaticResource Style.SectionHeader}" />
            <CheckBox ToolTip="Текущее время под таймером" Content="Показывать текущее время" IsChecked="{Binding ShowClock}" />
            <CheckBox ToolTip="Часы с секундами" Content="С секундами" IsChecked="{Binding ShowClockSeconds}" IsEnabled="{Binding ShowClock}" Margin="20,4,0,4" />
            <CheckBox ToolTip="Дата рядом с часами" Content="Показывать дату" IsChecked="{Binding ShowDate}" />

            <!-- ============ Настройка клавиш (докладка 2026-10-01): всё про клавиши — в окне HotkeysWindow по кнопке. ============ -->
            <TextBlock Text="Настройка клавиш" Style="{StaticResource Style.SectionHeader}" />
            <Button Content="Настройка клавиш" Click="OnOpenHotkeys" Style="{StaticResource Style.SettingsButton}"
                    HorizontalAlignment="Left" Margin="0,2,0,2"
                    ToolTip="Старт/пауза, сброс, компактный вид, показать/скрыть; клавиши окон и быстрого открытия окон" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,2"
                       Text="Клавиши таймера (в окне или везде), клавиши окон программ и быстрое открытие окон «Заставка и фон экрана», «Быстрые таймеры»." />
            <TextBlock Text="{Binding HotkeysWarning}" Style="{StaticResource Style.HotkeyWarning}" />

            <!-- ============ Быстрые таймеры (докладка 2026-10-01): в окне QuickTimersWindow по кнопке. ============ -->
            <TextBlock Text="Быстрые таймеры" Style="{StaticResource Style.SectionHeader}" />
            <Button Content="Настроить быстрые таймеры" Click="OnOpenQuickTimers" Style="{StaticResource Style.SettingsButton}"
                    HorizontalAlignment="Left" Margin="0,2,0,2"
                    ToolTip="До 5 таймеров на своих клавишах: время, клавиша, эффект, звук" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,2"
                       Text="Таймер на своей клавише запускается заново где бы вы ни были, даже когда окно в трее." />
            <TextBlock Text="{Binding QuickTimersWarning}" Style="{StaticResource Style.HotkeyWarning}" />


            <!-- ============ Сон и мониторы (докладка 2026-09-28, Services/PowerService.cs) ============ -->
            <TextBlock Text="Сон и мониторы" Style="{StaticResource Style.SectionHeader}" />
            <CheckBox ToolTip="Разбудить компьютер к окончанию таймера (таймер пробуждения Windows)" Content="Будить компьютер из сна к окончанию таймера" IsChecked="{Binding WakeFromSleepOnFinish}" />
            <CheckBox ToolTip="Включить погасшие мониторы, когда таймер закончился" Content="Включать мониторы, когда таймер закончился" IsChecked="{Binding WakeDisplayOnFinish}" />
            <TextBlock Text="Пока таймер идёт, программа не мешает компьютеру и мониторам засыпать. Пробуждение из сна работает, если в схеме питания Windows разрешены таймеры пробуждения."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0" />

            <!-- ============ Заставка и фон экрана (докладка 2026-09-30): вместо раздела «Фон рабочего стола» — кнопка,
                 всё про фон (и «Закрепить фоны») — в окне DesktopBackgroundWindow. ============ -->
            <TextBlock Text="Заставка и фон экрана" Style="{StaticResource Style.SectionHeader}" />
            <Button Content="Управление заставкой и фоном экрана" Click="OnOpenDesktopBackground" Style="{StaticResource Style.SettingsButton}"
                    HorizontalAlignment="Left" Margin="0,2,0,2"
                    ToolTip="Своя картинка фона с режимом на каждый монитор, закрепление слайд-шоу Windows" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6"
                       Text="Своя картинка на рабочий стол — на каждом мониторе можно выбрать, как она ложится; остановка слайд-шоу Windows." />

            <!-- ============ Окна программ (объединено 2026-09-29): всё, что Тайм2гаджет делает с окнами ДРУГИХ программ —
                 возврат после сна (WindowLayoutService), место между запусками (AppWindowMemoryService), размер и положение
                 по профилям (окно WindowProfilesWindow, WindowProfileService) и права администратора для всего этого. ============ -->
            <TextBlock Text="Окна программ" Style="{StaticResource Style.SectionHeader}" />
            <CheckBox ToolTip="После сна вернуть окна программ на их мониторы" IsChecked="{Binding RestoreOtherWindows}">
                <TextBlock Text="Возвращать окна других программ на их мониторы после сна и/или гашения мониторов" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox ToolTip="Оконные программы и игры при новом запуске открываются на прежнем месте и того же размера" IsChecked="{Binding RememberAppWindows}">
                <TextBlock Text="Открывать окна программ там, где их закрыли" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="20,0,0,4"
                       Text="Закрыли программу или игру в окне — при следующем запуске окно встанет на то же место и будет того же размера. Полноэкранные окна и «полный экран в окне» не трогаются; программы с несколькими окнами одного вида (например, папки проводника) — тоже." />
            <Button Content="Размер и положение окон программ" Click="OnOpenWindowProfiles" Style="{StaticResource Style.SettingsButton}"
                    HorizontalAlignment="Left" Margin="0,6,0,2"
                    ToolTip="Окно без рамки, точное место и размер, быстрые кнопки по краям монитора; профили, которые применяются к программе сами" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6"
                       Text="Для отдельной программы или игры можно задать точное место и размер окна, убрать рамку и заголовок, прижать окно к краю монитора. Удачную настройку можно сохранить профилем — тогда программа будет всегда открываться именно так." />
            <!-- Окна программ «от администратора» Windows даёт двигать только программе с такими же правами. Services/ElevationService. -->
            <CheckBox ToolTip="Нужно, чтобы двигать окна программ, запущенных от администратора" IsChecked="{Binding RunElevated}">
                <TextBlock Text="Запускать с правами администратора" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="20,0,0,0"
                       Text="Нужно для окон программ, запущенных от администратора (иначе Windows не даёт их двигать) — для всех функций выше. Разрешение спрашивается один раз при включении, дальше запуск без запросов." />
            <!-- Текущий режим — выделен и переносится (длинный вариант «…с правами администратора» не влезал, 2026-09-28). -->
            <TextBlock Text="{Binding ElevationStatusText, Mode=OneTime}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="20,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunningElevated, Mode=OneTime}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ============ Обновления — внизу (автопроверка при запуске и раз в сутки идёт сама) ============ -->
            <TextBlock x:Name="UpdatesSection" Text="Обновления" Style="{StaticResource Style.SectionHeader}" />
            <TextBlock Text="{Binding CurrentVersionText}" Foreground="{StaticResource Brush.TextSecondary}" />
            <!-- Нашлось обновление — на месте «Проверить обновления» кнопка установки (докладка 2026-09-27: баннер
                 вверху настроек был неочевиден — закрыв настройки, кнопку легко потерять). -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button ToolTip="Проверить новую версию на GitHub" Content="Проверить обновления" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource Style.SettingsButton}"
                        Visibility="{Binding IsUpdateNotAvailable, Converter={StaticResource BoolToVis}}" />
                <Button ToolTip="Скачать и установить новую версию" Content="{Binding InstallUpdateButtonText}" Command="{Binding InstallUpdateCommand}" Style="{StaticResource Style.SettingsButton}"
                        BorderBrush="{StaticResource Brush.UpdateAccent}" Background="{StaticResource Brush.UpdateBannerBackground}"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextWrapping="Wrap" MaxWidth="150" Foreground="{StaticResource Brush.TextSecondary}" />
            </StackPanel>

            <!-- ============ Сброс (докладка 2026-09-28) — с подтверждением, см. MainViewModel.ResetSettings ============ -->
            <TextBlock Text="Сброс" Style="{StaticResource Style.SectionHeader}" />
            <Button ToolTip="Все настройки по умолчанию, окна — на исходные места" Content="Сбросить настройки и положение окон" Command="{Binding ResetSettingsCommand}"
                    Style="{StaticResource Style.SettingsButton}" HorizontalAlignment="Left" />

            <!-- ============ Об авторе ============ -->
            <TextBlock Text="Об авторе" Style="{StaticResource Style.SectionHeader}" />
            <!-- Аватарка высотой в две строки (анимированный GIF — Controls/AnimatedGif), справа имя-ссылка (страница автора —
                 пока заглушка) и выпуски на GitHub; ниже без изменений — VirusTotal (докладка 2026-09-28). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Width="44" Height="44" c:AnimatedGif.Source="pack://application:,,,/Assets/Avatar/author.gif"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Какая-то старая аватарка">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,44,44" RadiusX="8" RadiusY="8" />
                    </Image.Clip>
                </Image>
                <Button Grid.Column="1" Content="{x:Static vm:MainViewModel.Author}" Style="{StaticResource Style.LinkButton}"
                        Command="{Binding OpenAuthorPageCommand}" ToolTip="Страница автора — скоро" Margin="10,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                <!-- Вторая строка: релизы на GitHub и правее — отчёт VirusTotal по установщику текущей версии
                     (хэш берётся из GitHub Release — UpdateService.GetVirusTotalUrlAsync). -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button ToolTip="Страница выпусков на GitHub" Content="GitHub релизы" Style="{StaticResource Style.LinkButton}"
                            Command="{Binding OpenGitHubCommand}" VerticalAlignment="Center" />
                    <Button ToolTip="Отчёт VirusTotal по установщику этой версии" Content="Проверка на VirusTotal" Style="{StaticResource Style.LinkButton}"
                            Command="{Binding OpenVirusTotalCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
