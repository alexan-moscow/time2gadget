<Window x:Class="Time2Gadget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:c="clr-namespace:Time2Gadget.Controls"
        xmlns:vm="clr-namespace:Time2Gadget.ViewModels"
        mc:Ignorable="d"
        Title="Настройки — Тайм2гаджет"
        Width="380" Height="620"
        Background="{StaticResource Brush.Background}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- Предупреждение под разделами клавиш: пустой текст — строки нет. -->
        <Style x:Key="Style.HotkeyWarning" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Finish}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопка прослушивания в списках звонков: ▶, пока звук этой строки играет — ■ (повторное нажатие гасит). -->
        <Style x:Key="Style.PreviewButton" TargetType="Button" BasedOn="{StaticResource Style.SettingsButton}">
            <Setter Property="Content" Value="▶" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="ToolTip" Value="Прослушать" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="■" />
                    <Setter Property="ToolTip" Value="Остановить" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- То же для эффектов: показ на циферблате главного окна. -->
        <Style x:Key="Style.EffectPreviewButton" TargetType="Button" BasedOn="{StaticResource Style.PreviewButton}">
            <Setter Property="ToolTip" Value="Показать на циферблате" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="ToolTip" Value="Остановить показ" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Длительность звука слева от ▶ — мелким узким шрифтом («45 сек», «1 мин 24 сек»). -->
        <Style x:Key="Style.SoundDuration" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift Condensed, Arial Narrow, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- Значок «где работает клавиша» (окно / глобус) — контур без заливки, одинаковый фон кнопки в обоих режимах. -->
        <Style x:Key="Style.KeyScopeIcon" TargetType="Path">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="StrokeThickness" Value="1.1" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Квадратные кнопки-иконки строки быстрого таймера (эффект, звук). Пока меню кнопки открыто, она не ловит мышь
             (DataTemplate.Triggers): иначе щелчок по ней закрыл бы меню (StaysOpen=False) и тут же открыл снова. -->
        <Style x:Key="Style.RowIconButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="4" BorderThickness="1" Background="{StaticResource Brush.SurfaceSector}"
                                BorderBrush="{StaticResource Brush.BorderSubtle}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceSectorHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Меню быстрого таймера (звук, эффект) — рамка всплывашки. -->
        <Style x:Key="Style.MenuBorder" TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
        </Style>

        <!-- Строка списка звонков во всплывашке — тёмная, выбранная подсвечена акцентом. -->
        <Style x:Key="Style.SoundListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="6,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceSectorHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Щелчок по пункту меню — выбрать и закрыть меню (кнопка ▶ внутри пункта сюда не относится). -->
        <Style x:Key="Style.QuickSoundItem" TargetType="ListBoxItem" BasedOn="{StaticResource Style.SoundListItem}">
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnQuickSoundItemClick" />
        </Style>
        <Style x:Key="Style.QuickEffectItem" TargetType="ListBoxItem" BasedOn="{StaticResource Style.SoundListItem}">
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnQuickEffectItemClick" />
        </Style>

        <!-- Пункт списка эффектов: название и ▶/■ просмотра (в выпадающем списке — только в раскрытом, не у «Отключено»). -->
        <DataTemplate x:Key="Template.EffectComboItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource Style.EffectPreviewButton}" Padding="8,1" FontSize="11" Margin="10,0,0,0"
                        PreviewMouseLeftButtonDown="OnEffectPreviewMouseDown" PreviewMouseLeftButtonUp="OnRingtonePreviewMouseUp">
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource RingtonePreviewVisibility}">
                            <Binding RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                            <Binding Path="CanPreview" />
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="20,10,20,20">
        <StackPanel>

            <!-- ============ Автозагрузка / закрытие ============ -->
            <TextBlock Text="Запуск и закрытие" Style="{StaticResource Style.SectionHeader}" Margin="0,0,0,8" />
            <CheckBox ToolTip="Запускать таймер при входе в Windows" Content="Запускать вместе с Windows" IsChecked="{Binding IsLaunchAtStartup}" />
            <CheckBox ToolTip="Окно таймера поверх других окон" Content="Поверх всех окон после запуска" IsChecked="{Binding IsAlwaysOnTop}" />

            <TextBlock Text="При закрытии окна:" Margin="0,10,0,4" />
            <ComboBox ToolTip="Что делает крестик в окне таймера" ItemsSource="{Binding CloseBehaviorOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding CloseBehavior}" />

            <!-- ============ Звук ============ -->
            <TextBlock Text="Звук" Style="{StaticResource Style.SectionHeader}" />

            <TextBlock Text="Устройство вывода:" Margin="0,0,0,4" />
            <ComboBox ToolTip="Куда выводить звонок" ItemsSource="{Binding AudioDevices}" DisplayMemberPath="FriendlyName"
                      SelectedItem="{Binding SelectedAudioDevice}" />

            <TextBlock Text="Громкость по умолчанию:" Margin="0,10,0,2" />
            <Slider ToolTip="Громкость звонка" Minimum="0" Maximum="1" Value="{Binding AlarmVolume}" TickFrequency="0.05" IsSnapToTickEnabled="True" />

            <TextBlock Text="Звонок:" Margin="0,10,0,4" />
            <!-- В каждой строке раскрытого списка — ▶: слушать звонок прямо в списке, не выбирая его
                 (докладка 2026-09-27). В закрытом поле ▶ не показывается (там кнопка всё равно не нажимается). -->
            <ComboBox ToolTip="Звонок по окончании таймера; ▶ в списке — прослушать" ItemsSource="{Binding RingtoneOptions}" SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedRingtoneId}" DropDownClosed="OnRingtoneDropDownClosed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel.Visibility>
                                    <MultiBinding Converter="{StaticResource RingtonePreviewVisibility}">
                                        <Binding RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                                        <Binding Path="CanPreview" />
                                    </MultiBinding>
                                </StackPanel.Visibility>
                                <TextBlock Text="{Binding DurationText}" Style="{StaticResource Style.SoundDuration}" />
                                <Button Style="{StaticResource Style.PreviewButton}" Tag="{Binding Id}" Padding="8,1" FontSize="11"
                                        PreviewMouseLeftButtonDown="OnRingtonePreviewMouseDown"
                                        PreviewMouseLeftButtonUp="OnRingtonePreviewMouseUp" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding IsCustomRingtoneSelected, Converter={StaticResource BoolToVis}}">
                <Button ToolTip="Выбрать свой файл (.mp3, .wav) — он копируется к программе" Content="Обзор…" Style="{StaticResource Style.SettingsButton}" Command="{Binding BrowseCustomSoundCommand}" />
                <TextBlock Text="{Binding CustomSoundFilePath}" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="200" />
            </StackPanel>

            <!-- Повторное нажатие гасит звук с затуханием (докладка 2026-09-28). -->
            <Button ToolTip="Прослушать выбранный звонок; повторно — стоп" Command="{Binding PreviewRingtoneCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" MinWidth="120">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Style.SettingsButton}">
                        <Setter Property="Content" Value="▶ Прослушать" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewPlaying}" Value="True">
                                <Setter Property="Content" Value="■ Стоп" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ============ Поведение при завершении ============ -->
            <TextBlock Text="Поведение таймера при завершении" Style="{StaticResource Style.SectionHeader}" />

            <TextBlock Text="{Binding AlarmRepeatCount, StringFormat='Сколько раз звонить: {0}'}" Margin="0,0,0,2" />
            <Slider ToolTip="Сколько раз проиграть звонок" Minimum="1" Maximum="10" Value="{Binding AlarmRepeatCount}" TickFrequency="1" IsSnapToTickEnabled="True" />

            <!-- ============ Визуальные эффекты ============ -->
            <TextBlock Text="Визуальный эффект во время отсчёта" Style="{StaticResource Style.SectionHeader}" />
            <!-- ▶ в раскрытом списке — показать эффект на циферблате; закрытие списка/выбор прекращает показ (2026-09-28). -->
            <ComboBox ToolTip="Эффект циферблата во время отсчёта; ▶ в списке — показать" ItemsSource="{Binding RunningEffectOptions}" SelectedValuePath="Value" SelectedValue="{Binding RunningEffect}"
                      ItemTemplate="{StaticResource Template.EffectComboItem}" DropDownClosed="OnEffectDropDownClosed" />

            <TextBlock Text="Визуальный эффект при завершении" Style="{StaticResource Style.SectionHeader}" />
            <ComboBox ToolTip="Эффект циферблата и трея по окончании; ▶ в списке — показать" ItemsSource="{Binding FinishEffectOptions}" SelectedValuePath="Value" SelectedValue="{Binding FinishEffect}"
                      ItemTemplate="{StaticResource Template.EffectComboItem}" DropDownClosed="OnEffectDropDownClosed" />
            <!-- Шкала 2 с … 5 мин и последним шагом «бесконечно» (MainViewModel.FinishEffectDurationSteps);
                 действует и на окно, и на трей. -->
            <TextBlock Text="{Binding FinishEffectDurationLabel}" Margin="0,10,0,2" />
            <Slider ToolTip="Сколько длится эффект по окончании" Minimum="0" Maximum="{Binding FinishEffectDurationMaxIndex, Mode=OneWay}"
                    Value="{Binding FinishEffectDurationIndex}" TickFrequency="1" IsSnapToTickEnabled="True" />

            <!-- ============ Размер видов — отдельно полный и компактный (докладка 2026-09-27) ============ -->
            <TextBlock Text="Размер" Style="{StaticResource Style.SectionHeader}" />
            <TextBlock Text="{Binding FullViewScaleLabel}" Margin="0,0,0,2" />
            <Slider ToolTip="Размер полного вида" Minimum="0.6" Maximum="1.6" Value="{Binding FullViewScale}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding CompactViewScaleLabel}" Margin="0,10,0,2" />
            <Slider ToolTip="Размер компактного вида" Minimum="0.6" Maximum="1.6" Value="{Binding CompactViewScale}" TickFrequency="0.05" IsSnapToTickEnabled="True" />

            <!-- ============ Часы под статусом ============ -->
            <TextBlock Text="Часы" Style="{StaticResource Style.SectionHeader}" />
            <CheckBox ToolTip="Текущее время под таймером" Content="Показывать текущее время" IsChecked="{Binding ShowClock}" />
            <CheckBox ToolTip="Часы с секундами" Content="С секундами" IsChecked="{Binding ShowClockSeconds}" IsEnabled="{Binding ShowClock}" Margin="20,4,0,4" />
            <CheckBox ToolTip="Дата рядом с часами" Content="Показывать дату" IsChecked="{Binding ShowDate}" />

            <!-- ============ Клавиши (докладка 2026-09-28): поле — щёлкнуть и нажать сочетание, Controls/HotkeyBox.
                 Справа значок «где работает»: окно — только в активном окне таймера, глобус — везде (глобальная клавиша);
                 щелчок переключает (MainViewModel.ToggleKeyScopeCommand). Под списком — легенда значков. ============ -->
            <TextBlock Text="Клавиши" Style="{StaticResource Style.SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Старт / пауза" VerticalAlignment="Center" />
                <c:HotkeyBox Grid.Column="1" BindingValue="{Binding StartPauseKey}" Margin="0,2" />
                <Button Grid.Column="2" Style="{StaticResource Style.RowIconButton}" Margin="6,0,0,0" ToolTip="{Binding StartPauseGlobal, Converter={StaticResource BoolToText}, ConverterParameter='Работает везде. Щелчок — только в окне таймера|Работает только в окне таймера. Щелчок — везде'}"
                        Command="{Binding ToggleKeyScopeCommand}" CommandParameter="StartPause">
                    <Path Style="{StaticResource Style.KeyScopeIcon}"
                          Data="{Binding StartPauseGlobal, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.KeyGlobe|Geometry.KeyWindow}" />
                </Button>
                <TextBlock Grid.Row="1" Text="Сброс" VerticalAlignment="Center" />
                <c:HotkeyBox Grid.Row="1" Grid.Column="1" BindingValue="{Binding ResetKey}" Margin="0,2" />
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Style.RowIconButton}" Margin="6,0,0,0" ToolTip="{Binding ResetGlobal, Converter={StaticResource BoolToText}, ConverterParameter='Работает везде. Щелчок — только в окне таймера|Работает только в окне таймера. Щелчок — везде'}"
                        Command="{Binding ToggleKeyScopeCommand}" CommandParameter="Reset">
                    <Path Style="{StaticResource Style.KeyScopeIcon}"
                          Data="{Binding ResetGlobal, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.KeyGlobe|Geometry.KeyWindow}" />
                </Button>
                <TextBlock Grid.Row="2" Text="Компактный вид" VerticalAlignment="Center" />
                <c:HotkeyBox Grid.Row="2" Grid.Column="1" BindingValue="{Binding CompactKey}" Margin="0,2" />
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Style.RowIconButton}" Margin="6,0,0,0" ToolTip="{Binding CompactGlobal, Converter={StaticResource BoolToText}, ConverterParameter='Работает везде. Щелчок — только в окне таймера|Работает только в окне таймера. Щелчок — везде'}"
                        Command="{Binding ToggleKeyScopeCommand}" CommandParameter="Compact">
                    <Path Style="{StaticResource Style.KeyScopeIcon}"
                          Data="{Binding CompactGlobal, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.KeyGlobe|Geometry.KeyWindow}" />
                </Button>
                <TextBlock Grid.Row="3" Text="Показать / скрыть окно" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <c:HotkeyBox Grid.Row="3" Grid.Column="1" BindingValue="{Binding ShowHideKey}" Margin="0,2" />
                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource Style.RowIconButton}" Margin="6,0,0,0" ToolTip="{Binding ShowHideGlobal, Converter={StaticResource BoolToText}, ConverterParameter='Работает везде. Щелчок — только в окне таймера|Работает только в окне таймера. Щелчок — везде'}"
                        Command="{Binding ToggleKeyScopeCommand}" CommandParameter="ShowHide">
                    <Path Style="{StaticResource Style.KeyScopeIcon}"
                          Data="{Binding ShowHideGlobal, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.KeyGlobe|Geometry.KeyWindow}" />
                </Button>
            </Grid>

            <!-- Легенда значков. -->
            <Grid Margin="0,6,0,0" TextElement.FontSize="11" TextElement.Foreground="{StaticResource Brush.TextSecondary}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Path Style="{StaticResource Style.KeyScopeIcon}" Data="{StaticResource Geometry.KeyWindow}" Stroke="{StaticResource Brush.TextSecondary}"
                      Width="11" Height="11" VerticalAlignment="Top" Margin="0,2,6,0" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="В окне — работает, только когда окно таймера активно." />
                <Path Grid.Row="1" Style="{StaticResource Style.KeyScopeIcon}" Data="{StaticResource Geometry.KeyGlobe}" Stroke="{StaticResource Brush.TextSecondary}"
                      Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,6,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Везде — глобальная клавиша: работает в любой программе, даже когда окно свёрнуто в трей." />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Щелчок по значку переключает режим; при переходе на «везде» старт/пауза и сброс получают Ctrl+F10 / Ctrl+F11 (можно назначить другие). Esc в окне таймера всегда сбрасывает." />
            </Grid>
            <TextBlock Text="{Binding HotkeysWarning}" Style="{StaticResource Style.HotkeyWarning}" />
            <TextBlock Text="{Binding HotkeysWarning}" Style="{StaticResource Style.HotkeyWarning}" />

            <!-- ============ Быстрые таймеры (докладка 2026-09-28): N ЧЧ ММ СС [клавиша] [звук] ×, до 5 строк ============ -->
            <TextBlock Text="Быстрые таймеры" Style="{StaticResource Style.SectionHeader}" />
            <ItemsControl ItemsSource="{Binding QuickTimers}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{StaticResource Brush.TextSecondary}" />
                            <c:TimeSpinner Grid.Column="1" Height="24" Maximum="23" Value="{Binding Hours}" ToolTip="Часы" />
                            <c:TimeSpinner Grid.Column="2" Height="24" Value="{Binding Minutes}" ToolTip="Минуты" Margin="2,0,0,0" />
                            <c:TimeSpinner Grid.Column="3" Height="24" Value="{Binding Seconds}" ToolTip="Секунды" Margin="2,0,0,0" />
                            <c:HotkeyBox Grid.Column="4" BindingValue="{Binding Binding}" Margin="4,0,0,0" />

                            <!-- Эффект завершения таймера: иконка текущего эффекта («—» нет), меню с просмотром. -->
                            <Button x:Name="EffectButton" Grid.Column="5" Margin="4,0,0,0" Style="{StaticResource Style.RowIconButton}"
                                    Command="{Binding EffectCommand}" ToolTip="{Binding EffectToolTip}">
                                <ContentControl Content="{Binding FinishEffect, Converter={StaticResource EffectIcon}}" Focusable="False" />
                            </Button>
                            <Popup Grid.Column="5" PlacementTarget="{Binding ElementName=EffectButton}" Placement="Bottom" HorizontalOffset="-150"
                                   StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsEffectMenuOpen, Mode=TwoWay}"
                                   Closed="OnQuickEffectPopupClosed">
                                <Border Width="190" Style="{StaticResource Style.MenuBorder}">
                                    <ListBox ItemsSource="{Binding EffectOptions}" SelectedValuePath="Value" SelectedValue="{Binding FinishEffect, Mode=OneWay}"
                                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Style.QuickEffectItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl Content="{Binding Value, Converter={StaticResource EffectIcon}}" Focusable="False"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Style="{StaticResource Style.EffectPreviewButton}" Padding="6,0" FontSize="10"
                                                            Visibility="{Binding CanPreview, Converter={StaticResource BoolToVis}}"
                                                            PreviewMouseLeftButtonDown="OnEffectPreviewMouseDown"
                                                            PreviewMouseLeftButtonUp="OnRingtonePreviewMouseUp" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>

                            <!-- Звук: включён — колокольчик синий, щелчок выключает; выключен — перечёркнут, щелчок открывает меню. -->
                            <Button x:Name="SoundButton" Grid.Column="6" Margin="4,0,0,0" Style="{StaticResource Style.RowIconButton}"
                                    Command="{Binding BellCommand}" ToolTip="{Binding SoundToolTip}">
                                <Grid Width="12" Height="12">
                                    <Path x:Name="Bell" Stretch="Uniform" StrokeThickness="1.2"
                                          Data="M6,0.8 C3.9,0.8 2.6,2.4 2.6,4.6 L2.6,7.4 L1.2,9.2 L10.8,9.2 L9.4,7.4 L9.4,4.6 C9.4,2.4 8.1,0.8 6,0.8 Z M4.4,10 A1.6,1.6 0 0 0 7.6,10 Z"
                                          Stroke="{StaticResource Brush.TextSecondary}" Fill="Transparent" />
                                    <Path x:Name="BellSlash" Data="M0.5,11.5 L11.5,0.5" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.4" />
                                </Grid>
                            </Button>
                            <Popup Grid.Column="6" PlacementTarget="{Binding ElementName=SoundButton}" Placement="Bottom" HorizontalOffset="-230"
                                   StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsSoundMenuOpen, Mode=TwoWay}"
                                   Closed="OnQuickSoundPopupClosed">
                                <Border Width="260" Style="{StaticResource Style.MenuBorder}">
                                    <StackPanel>
                                        <!-- Громкость: «общая» — из раздела «Звук»; тронули ползунок — галочка снимается сама. -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Громкость" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" Content="общая" IsChecked="{Binding UseGeneralVolume}" Margin="8,0,0,0"
                                                      VerticalAlignment="Center" ToolTip="Громкость как в разделе «Звук»" />
                                            <Slider ToolTip="Своя громкость этого таймера (снимает «общая»)" Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding VolumeValue}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1" />
                                        </Grid>
                                        <!-- Щелчок по звонку — выбрать, включить звук и закрыть меню. -->
                                        <ListBox ItemsSource="{Binding SoundOptions}" SelectedValuePath="Id" SelectedValue="{Binding RingtoneKey}"
                                                 Height="200" Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource Style.QuickSoundItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Visibility="{Binding CanPreview, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource Style.SoundDuration}" />
                                                            <Button Style="{StaticResource Style.PreviewButton}" Tag="{Binding Id}" Padding="6,0" FontSize="10"
                                                                    PreviewMouseLeftButtonDown="OnQuickSoundPreviewMouseDown"
                                                                    PreviewMouseLeftButtonUp="OnRingtonePreviewMouseUp" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <!-- Свой файл таймера: копия в папке звуков программы. -->
                                        <Grid Margin="0,6,0,0" Visibility="{Binding IsCustomFileSelected, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button ToolTip="Выбрать другой файл для этого таймера" Content="Обзор…" Command="{Binding BrowseSoundCommand}" Style="{StaticResource Style.SettingsButton}"
                                                    Padding="8,2" Margin="0" />
                                            <TextBlock Grid.Column="1" Text="{Binding CustomFileName}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding CustomFileName}" />
                                        </Grid>
                                        <TextBlock Text="Устройство" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,8,0,4" />
                                        <ComboBox ToolTip="Куда выводить звонок этого таймера" ItemsSource="{Binding DeviceOptions}" DisplayMemberPath="FriendlyName"
                                                  SelectedValuePath="Id" SelectedValue="{Binding DeviceKey}" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Button Grid.Column="7" Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource Style.SettingsButton}"
                                    Width="22" Height="24" Padding="0" Margin="4,0,0,0" ToolTip="Удалить таймер" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding SoundEnabled}" Value="True">
                                <Setter TargetName="Bell" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Bell" Property="Fill" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="BellSlash" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSoundMenuOpen}" Value="True">
                                <Setter TargetName="SoundButton" Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEffectMenuOpen}" Value="True">
                                <Setter TargetName="EffectButton" Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button ToolTip="Добавить быстрый таймер (до 5)" Content="+ Добавить таймер" Command="{Binding AddQuickTimerCommand}" Style="{StaticResource Style.SettingsButton}"
                    HorizontalAlignment="Left" Margin="0,6,0,0"
                    Visibility="{Binding CanAddQuickTimer, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="Клавиша запускает таймер на это время заново — где бы вы ни были, даже когда окно в трее. Колокольчик — свой звонок и устройство (подсвечен, если заданы)."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding QuickTimersWarning}" Style="{StaticResource Style.HotkeyWarning}" />

            <!-- ============ Сон и мониторы (докладка 2026-09-28, Services/PowerService.cs) ============ -->
            <TextBlock Text="Сон и мониторы" Style="{StaticResource Style.SectionHeader}" />
            <CheckBox ToolTip="Разбудить компьютер к окончанию таймера (таймер пробуждения Windows)" Content="Будить компьютер из сна к окончанию таймера" IsChecked="{Binding WakeFromSleepOnFinish}" />
            <CheckBox ToolTip="Включить погасшие мониторы, когда таймер закончился" Content="Включать мониторы, когда таймер закончился" IsChecked="{Binding WakeDisplayOnFinish}" />
            <CheckBox ToolTip="После сна вернуть окна программ на их мониторы" IsChecked="{Binding RestoreOtherWindows}">
                <TextBlock Text="Возвращать окна других программ на их мониторы после сна и/или гашения мониторов" TextWrapping="Wrap" />
            </CheckBox>
            <!-- Окна программ между их запусками (докладка 2026-09-28, Services/AppWindowMemoryService). -->
            <CheckBox ToolTip="Оконные программы и игры при новом запуске открываются на прежнем месте и того же размера" IsChecked="{Binding RememberAppWindows}">
                <TextBlock Text="Открывать окна программ там, где их закрыли" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="20,0,0,4"
                       Text="Закрыли программу или игру в окне — при следующем запуске окно встанет на то же место и будет того же размера. Полноэкранные окна и «полный экран в окне» не трогаются; программы с несколькими окнами одного вида (например, папки проводника) — тоже." />
            <!-- Подпункт обеих функций про чужие окна: окна программ «от администратора» Windows даёт двигать только
                 программе с такими же правами (докладка 2026-09-28). Services/ElevationService. -->
            <StackPanel Margin="20,2,0,0" IsEnabled="{Binding CanRunElevated}">
                <CheckBox ToolTip="Нужно, чтобы двигать окна программ, запущенных от администратора" IsChecked="{Binding RunElevated}">
                    <TextBlock Text="Запускать с правами администратора" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="20,0,0,0"
                           Text="Нужно для окон программ, запущенных от администратора (иначе Windows не даёт их двигать) — для обеих функций выше. Разрешение спрашивается один раз при включении, дальше запуск без запросов." />
                <!-- Текущий режим — выделен и переносится (длинный вариант «…с правами администратора» не влезал, 2026-09-28). -->
                <TextBlock Text="{Binding ElevationStatusText, Mode=OneTime}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="20,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunningElevated, Mode=OneTime}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <TextBlock Text="Пока таймер идёт, программа не мешает компьютеру и мониторам засыпать. Пробуждение из сна работает, если в схеме питания Windows разрешены таймеры пробуждения."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0" />

            <!-- ============ Профили размера окон (докладка 2026-09-29) — отдельное окно Views/WindowProfilesWindow ============ -->
            <TextBlock Text="Профили размера окон" Style="{StaticResource Style.SectionHeader}" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6"
                       Text="Положение, размер и рамка окон программ и игр: быстрые кнопки по углам и сторонам монитора, точные значения, «окно без рамки». Настройку можно сохранить профилем и применять к программе автоматически." />
            <Button Content="Открыть профили размера окон…" Click="OnOpenWindowProfiles" Style="{StaticResource Style.SettingsButton}"
                    HorizontalAlignment="Left" ToolTip="Окно с настройкой положения и размера окон других программ" />

            <!-- ============ Обновления — внизу (автопроверка при запуске и раз в сутки идёт сама) ============ -->
            <TextBlock x:Name="UpdatesSection" Text="Обновления" Style="{StaticResource Style.SectionHeader}" />
            <TextBlock Text="{Binding CurrentVersionText}" Foreground="{StaticResource Brush.TextSecondary}" />
            <!-- Нашлось обновление — на месте «Проверить обновления» кнопка установки (докладка 2026-09-27: баннер
                 вверху настроек был неочевиден — закрыв настройки, кнопку легко потерять). -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button ToolTip="Проверить новую версию на GitHub" Content="Проверить обновления" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource Style.SettingsButton}"
                        Visibility="{Binding IsUpdateNotAvailable, Converter={StaticResource BoolToVis}}" />
                <Button ToolTip="Скачать и установить новую версию" Content="{Binding InstallUpdateButtonText}" Command="{Binding InstallUpdateCommand}" Style="{StaticResource Style.SettingsButton}"
                        BorderBrush="{StaticResource Brush.UpdateAccent}" Background="{StaticResource Brush.UpdateBannerBackground}"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextWrapping="Wrap" MaxWidth="150" Foreground="{StaticResource Brush.TextSecondary}" />
            </StackPanel>

            <!-- ============ Сброс (докладка 2026-09-28) — с подтверждением, см. MainViewModel.ResetSettings ============ -->
            <TextBlock Text="Сброс" Style="{StaticResource Style.SectionHeader}" />
            <Button ToolTip="Все настройки по умолчанию, окна — на исходные места" Content="Сбросить настройки и положение окон" Command="{Binding ResetSettingsCommand}"
                    Style="{StaticResource Style.SettingsButton}" HorizontalAlignment="Left" />

            <!-- ============ Об авторе ============ -->
            <TextBlock Text="Об авторе" Style="{StaticResource Style.SectionHeader}" />
            <!-- Аватарка высотой в две строки (анимированный GIF — Controls/AnimatedGif), справа имя-ссылка (страница автора —
                 пока заглушка) и выпуски на GitHub; ниже без изменений — VirusTotal (докладка 2026-09-28). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Width="44" Height="44" c:AnimatedGif.Source="pack://application:,,,/Assets/Avatar/author.gif"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Какая-то старая аватарка">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,44,44" RadiusX="8" RadiusY="8" />
                    </Image.Clip>
                </Image>
                <Button Grid.Column="1" Content="{x:Static vm:MainViewModel.Author}" Style="{StaticResource Style.LinkButton}"
                        Command="{Binding OpenAuthorPageCommand}" ToolTip="Страница автора — скоро" Margin="10,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                <!-- Вторая строка: релизы на GitHub и правее — отчёт VirusTotal по установщику текущей версии
                     (хэш берётся из GitHub Release — UpdateService.GetVirusTotalUrlAsync). -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button ToolTip="Страница выпусков на GitHub" Content="GitHub релизы" Style="{StaticResource Style.LinkButton}"
                            Command="{Binding OpenGitHubCommand}" VerticalAlignment="Center" />
                    <Button ToolTip="Отчёт VirusTotal по установщику этой версии" Content="Проверка на VirusTotal" Style="{StaticResource Style.LinkButton}"
                            Command="{Binding OpenVirusTotalCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
