<Window x:Class="Time2Gadget.Views.DesktopBackgroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Time2Gadget.Models"
        xmlns:vm="clr-namespace:Time2Gadget.ViewModels"
        xmlns:c="clr-namespace:Time2Gadget.Controls"
        Title="Фоновая заставка и слайдшоу экрана — Тайм2гаджет"
        Width="780" SizeToContent="Height" MinWidth="640"
        Background="{StaticResource Brush.Background}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">
    <!-- Докладка 2026-09-30: ViewModels/DesktopBackgroundViewModel, состояние — MainViewModel.Wallpaper.cs. -->
    <Window.Resources>
        <!-- Иконки режимов: рамка монитора и одна простая фигура, только линии (без заливок). Поле 24×16. -->
        <Geometry x:Key="Geo.Screen">M3,2 H21 V14 H3 Z</Geometry>
        <Geometry x:Key="Geo.Stretch">M7,8 H17 M7,8 L9.5,5.8 M7,8 L9.5,10.2 M17,8 L14.5,5.8 M17,8 L14.5,10.2</Geometry>
        <Geometry x:Key="Geo.Fit">M8,2 V14 M16,2 V14</Geometry>
        <Geometry x:Key="Geo.Fill">M0,2 H3 M21,2 H24 M0,14 H3 M21,14 H24</Geometry>
        <Geometry x:Key="Geo.Center">M9,5.5 H15 V10.5 H9 Z</Geometry>
        <Geometry x:Key="Geo.None">M3,14 L21,2</Geometry>

        <!-- Раздел режима: пока включён другой режим — приглушён и недоступен. -->
        <Style x:Key="Style.ModeSection" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Строка состояния: пустая — не занимает места. -->
        <Style x:Key="Style.StatusLine" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Прокрутка как в остальных окнах: полоса у правого края окна (поле справа — у содержимого). -->
    <ScrollViewer Margin="16,16,0,16" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
    <StackPanel>
        <!-- ============ Режим 1: статичная заставка / сплошной фон — картинка + режим на каждый монитор + «✕».
             Включён может быть только один из двух режимов: пока включён другой, раздел приглушён и недоступен. ============ -->
        <StackPanel IsEnabled="{Binding Main.IsStaticSectionEnabled}" Style="{StaticResource Style.ModeSection}">
        <Grid Margin="0,4,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Статичная заставка / сплошной фон" Style="{StaticResource Style.SectionHeader}" Margin="10,0,0,0" VerticalAlignment="Center" />
            <ToggleButton Style="{StaticResource Style.ToggleSwitch}" IsChecked="{Binding Main.StaticWallpaperEnabled}" VerticalAlignment="Center"
                          ToolTip="Включено — картинка/цвета на мониторах; выключено — прежний фон (настройки сохраняются)" />
        </Grid>
        <!-- Плитки мониторов (докладка 2026-10-01): рамка со скруглением, сверху «Монитор N» под чертой, ниже — его картинка так,
             как ляжет на экран (или цвет, или «не выбрано»); клик ЛКМ — окно выбора картинки. Справа — режим, цвет, «✕». -->
        <ItemsControl ItemsSource="{Binding Monitors}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                        <Button Command="{Binding OpenCommand}" ToolTip="{Binding TileToolTip}" Cursor="Hand" Width="236" Focusable="False" x:Name="Tile">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Frame" CornerRadius="7" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderSubtle}"
                                            Background="{StaticResource Brush.SurfaceSector}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="120" /></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Label}" Margin="10,5,10,5" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" />
                                            <Border Grid.Row="1" Height="1" Background="{StaticResource Brush.BorderSubtle}" />
                                            <c:MonitorPreview Grid.Row="2" Margin="6" ImagePath="{Binding PreviewImage}" Fit="{Binding PreviewFit}" ColorHex="{Binding PreviewColor}" SpanArea="{Binding SpanArea}"
                                                              MonitorWidth="{Binding MonitorWidth}" MonitorHeight="{Binding MonitorHeight}" EmptyText="не выбрано" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- справа столбиком: режим (есть картинка), сплошной цвет (картинки нет), «✕» -->
                        <DockPanel Margin="6,0,0,0" LastChildFill="False" Width="40"><!-- постоянная ширина: плитки в рядах — по столбцам, даже когда кнопок нет -->
                            <!-- самый низ: одна картинка этого монитора на все мониторы (только у «Монитора 1») -->
                            <Button DockPanel.Dock="Bottom" Command="{Binding SpanCommand}" ToolTip="{Binding SpanToolTip}" Style="{StaticResource Style.SettingsButton}"
                                    Padding="5" Margin="0" Visibility="{Binding IsSpanMain, Converter={StaticResource BoolToVis}}">
                                <Grid Width="26" Height="16">
                                    <Path Data="M0.6,2.6 H11.4 V12.4 H0.6 Z M14.6,2.6 H25.4 V12.4 H14.6 Z" StrokeThickness="1.2" Stroke="{StaticResource Brush.TextSecondary}" />
                                    <Path x:Name="SpanBand" Data="M2,5.5 H24 V9.5 H2 Z" Fill="{StaticResource Brush.TextSecondary}" Opacity="0.5" />
                                </Grid>
                            </Button>
                            <StackPanel DockPanel.Dock="Top">
                            <Button x:Name="FitButton" Command="{Binding CycleCommand}" ToolTip="{Binding ToolTip}" Style="{StaticResource Style.SettingsButton}"
                                    Padding="5" Margin="0,0,0,4" Visibility="{Binding ShowFitButton, Converter={StaticResource BoolToVis}}">
                                <Grid Width="24" Height="16">
                                    <Path Data="{StaticResource Geo.Screen}" StrokeThickness="1.3" Stroke="{Binding Foreground, ElementName=FitButton}" />
                                    <Path x:Name="FitIcon" Data="{StaticResource Geo.Stretch}" StrokeThickness="1.3" Stroke="{Binding Foreground, ElementName=FitButton}" />
                                </Grid>
                            </Button>
                            <Button x:Name="ColorButton" Command="{Binding OpenColorMenuCommand}" ToolTip="{Binding ColorToolTip}"
                                    Style="{StaticResource Style.SettingsButton}" Padding="8,4" Margin="0,0,0,4"
                                    Visibility="{Binding ShowColorButton, Converter={StaticResource BoolToVis}}">
                                <Grid Width="18" Height="18">
                                    <Border CornerRadius="2" Background="{Binding ColorBrush}" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderSubtle}" />
                                    <Path Data="M3,15 L15,3" StrokeThickness="1.3" Stroke="{StaticResource Brush.TextSecondary}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                            <Popup PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" IsOpen="{Binding IsColorMenuOpen, Mode=TwoWay}">
                                <Border x:Name="Palette" Padding="6" CornerRadius="6" BorderThickness="1" Margin="0,2,0,0"
                                        Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.BorderSubtle}">
                                    <ItemsControl ItemsSource="{Binding Source={x:Static vm:MonitorFitItem.BasicColors}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ChooseColorCommand, ElementName=Palette}"
                                                        CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Margin="2" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Swatch" Width="22" Height="22" CornerRadius="3" Background="{Binding Hex}"
                                                                    BorderThickness="1" BorderBrush="{StaticResource Brush.BorderSubtle}" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                                    <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                            <Button x:Name="ClearButton" Content="✕" Command="{Binding ClearCommand}" Style="{StaticResource Style.SettingsButton}" Padding="12,6" Margin="0"
                                    ToolTip="Клик ЛКМ — убрать картинку этого монитора: сплошной чёрный (цвет можно сменить квадратиком).&#x0a;Клик ПКМ — вернуть на этом мониторе фон, который был до этого">
                                <Button.InputBindings>
                                    <MouseBinding Gesture="RightClick" Command="{Binding RestoreCommand}" />
                                </Button.InputBindings>
                            </Button>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSpanActive}" Value="True">
                            <Setter TargetName="SpanBand" Property="Fill" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="SpanBand" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <!-- кусок картинки монитора 1: выбор своей картинки и «✕» недоступны -->
                        <DataTrigger Binding="{Binding IsSpanFollower}" Value="True">
                            <Setter TargetName="Tile" Property="IsEnabled" Value="False" />
                            <Setter TargetName="Tile" Property="ToolTip" Value="{Binding FollowerToolTip}" />
                            <Setter TargetName="Tile" Property="ToolTipService.ShowOnDisabled" Value="True" />
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Fit}" Value="{x:Static m:WallpaperFit.Fit}">
                            <Setter TargetName="FitIcon" Property="Data" Value="{StaticResource Geo.Fit}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Fit}" Value="{x:Static m:WallpaperFit.Fill}">
                            <Setter TargetName="FitIcon" Property="Data" Value="{StaticResource Geo.Fill}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Fit}" Value="{x:Static m:WallpaperFit.Center}">
                            <Setter TargetName="FitIcon" Property="Data" Value="{StaticResource Geo.Center}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- текущий способ «одна картинка на все мониторы» -->
        <TextBlock Text="{Binding SpanStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,4"
                   Visibility="{Binding HasSpanStatus, Converter={StaticResource BoolToVis}}" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0"
                   Text="У каждого монитора своя картинка: клик ЛКМ по монитору — выбрать. Кнопка справа меняет, как картинка ложится: растянуть → по размеру → заполнить → по центру. Без картинки квадратик задаёт сплошной цвет. «✕»: клик ЛКМ — сплошной чёрный, клик ПКМ — фон, который был до этого. Кнопка внизу у монитора 1 — его картинка на все мониторы: охватить (заполнить общий экран, лишнее обрезается) → растянуть → вписать целиком → та же картинка на каждом; «✕» у монитора 1 выключает." />
        <TextBlock Text="{Binding Status}" Style="{StaticResource Style.StatusLine}" Foreground="{StaticResource Brush.UpdateAccent}" />
        </StackPanel>

        <!-- ============ Режим 2: динамичная заставка / слайдшоу — расписание, шаги на каждый монитор (окно SlideshowEditorWindow). ============ -->
        <StackPanel IsEnabled="{Binding Main.IsSlideshowSectionEnabled}" Style="{StaticResource Style.ModeSection}">
            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Динамичная заставка / слайдшоу" Style="{StaticResource Style.SectionHeader}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Style.ToggleSwitch}" IsChecked="{Binding Main.SlideshowEnabled}" VerticalAlignment="Center"
                              ToolTip="Включено — картинки меняются по расписанию на всех мониторах разом; выключено — прежний фон" />
            </Grid>
            <WrapPanel DataContext="{Binding Main}">
                <TextBlock Text="Смена изображений" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="118" />
                <ComboBox Width="136" SelectedIndex="{Binding SlideshowKindIndex}" Margin="0,2,8,2" VerticalAlignment="Center">
                    <ComboBoxItem Content="раз в час" />
                    <ComboBoxItem Content="раз в сутки" />
                    <ComboBoxItem Content="свой интервал" />
                </ComboBox>
                <!-- раз в час -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSlideshowHourly, Converter={StaticResource BoolToVis}}">
                    <ComboBox Width="214" SelectedIndex="{Binding SlideshowHourlyModeIndex}" Margin="0,2,8,2" VerticalAlignment="Center">
                        <ComboBoxItem Content="с указанного времени старта" ToolTip="Смена каждый час в минуты и секунды этого времени" />
                        <ComboBoxItem Content="каждый реальный час" ToolTip="Смена в начале каждого часа по местному времени (в :00)" />
                    </ComboBox>
                    <c:TimeOfDayBox Value="{Binding SlideshowHourlyStart}" VerticalAlignment="Center" ToolTip="Время старта"
                                    Visibility="{Binding ShowSlideshowHourlyTime, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <!-- раз в сутки -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSlideshowDaily, Converter={StaticResource BoolToVis}}">
                    <ComboBox Width="186" SelectedIndex="{Binding SlideshowDailyModeIndex}" Margin="0,2,8,2" VerticalAlignment="Center">
                        <ComboBoxItem Content="в указанное время" />
                        <ComboBoxItem Content="в начале суток (00:00)" />
                    </ComboBox>
                    <c:TimeOfDayBox Value="{Binding SlideshowDailyTime}" VerticalAlignment="Center" ToolTip="Время смены"
                                    Visibility="{Binding ShowSlideshowDailyTime, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <!-- свой интервал -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSlideshowInterval, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="каждые" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <c:TimeOfDayBox Value="{Binding SlideshowInterval}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Интервал: часы, минуты, секунды — не меньше 1 секунды подложкой и 2 секунд средствами Windows" />
                    <ComboBox Width="124" SelectedIndex="{Binding SlideshowIntervalModeIndex}" Margin="0,2,8,2" VerticalAlignment="Center">
                        <ComboBoxItem Content="старт сейчас" />
                        <ComboBoxItem Content="старт в" />
                    </ComboBox>
                    <c:TimeOfDayBox Value="{Binding SlideshowIntervalStart}" VerticalAlignment="Center" ToolTip="Время старта"
                                    Visibility="{Binding ShowSlideshowIntervalStart, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </WrapPanel>
            <!-- Эффект смены (докладка 2026-10-01): сначала способ показа, за ним эффект. Средствами Windows (по умолчанию) —
                 эффект один, родной плавный, выбрать нельзя; своим окном-подложкой — пять эффектов. -->
            <WrapPanel DataContext="{Binding Main}" Margin="0,4,0,0">
                <TextBlock Text="Эффект смены" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="118" />
                <ComboBox Width="186" SelectedIndex="{Binding SlideshowDisplayIndex}" Margin="0,2,8,2" VerticalAlignment="Center">
                    <ComboBoxItem Content="своим окном-подложкой"
                                  ToolTip="Своё окно за значками рабочего стола: эффекты смены, смена хоть раз в секунду. Работает, пока запущен Тайм2гаджет — при выходе на мониторах остаётся текущая картинка обычным фоном" />
                    <ComboBoxItem Content="средствами Windows"
                                  ToolTip="Обычный фон рабочего стола Windows: родная плавная смена, не чаще раза в 2 секунды" />
                </ComboBox>
                <ComboBox Width="196" SelectedIndex="{Binding SlideshowEffectIndex}" Margin="0,2,8,2" VerticalAlignment="Center"
                          Visibility="{Binding IsSlideshowUnderlay, Converter={StaticResource BoolToVis}}"
                          ToolTip="Как одна картинка сменяет другую">
                    <ComboBoxItem Content="мгновенно" />
                    <ComboBoxItem Content="плавное растворение" />
                    <ComboBoxItem Content="сдвиг" />
                    <ComboBoxItem Content="шторка" />
                    <ComboBoxItem Content="наплыв" />
                    <ComboBoxItem Content="пиксельное растворение" ToolTip="Старая картинка исчезает квадратами в случайном порядке" />
                    <ComboBoxItem Content="дисперсия" ToolTip="Старую картинку сдувает крупными кусками волной слева направо" />
                    <ComboBoxItem Content="распад" ToolTip="Старая картинка рассыпается мелкими частицами, как пепел" />
                </ComboBox>
                <TextBlock Text="может тормозить" Foreground="{StaticResource Brush.UpdateAccent}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{Binding IsHeavyEffect, Converter={StaticResource BoolToVis}}"
                           ToolTip="Распад рисует тысячи частиц — на слабом компьютере смена может подтормаживать" />
                <!-- средствами Windows: выбрать эффект Windows не даёт — у неё одна плавная смена -->
                <ComboBox Width="190" SelectedIndex="0" IsEnabled="False" Margin="0,2,8,2" VerticalAlignment="Center"
                          Visibility="{Binding IsSlideshowWindows, Converter={StaticResource BoolToVis}}"
                          ToolTip="Windows меняет фон своей плавной сменой — другого эффекта она не даёт; эффекты — при показе своим окном-подложкой">
                    <ComboBoxItem Content="плавно (как в Windows)" />
                </ComboBox>
            </WrapPanel>

            <!-- Мониторы: щелчок — окно шагов; «✕» правее — левый щелчок убрать шаги, правый — вернуть. -->
            <ItemsControl ItemsSource="{Binding SlideshowMonitors}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Button Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Style="{StaticResource Style.SettingsButton}" Padding="12,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                </StackPanel>
                            </Button>
                            <Button Content="✕" Command="{Binding ClearCommand}" ToolTip="{Binding ClearToolTip}"
                                    Style="{StaticResource Style.SettingsButton}" Padding="10,5" Margin="-1,4,0,4">
                                <Button.InputBindings>
                                    <MouseBinding Gesture="RightClick" Command="{Binding RestoreCommand}" />
                                </Button.InputBindings>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Main.SlideshowStatus}" Style="{StaticResource Style.StatusLine}" Foreground="{StaticResource Brush.Accent}" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"
                       Text="На каждом мониторе — до 30 шагов (клик ЛКМ по монитору). Все мониторы идут по шагам вместе: шаг 1, шаг 2… и по кругу до последнего заполненного шага. Пустой шаг монитора — его прежний фон." />
            <!-- Слайд-шоу Windows (без своего раздела, докладка 2026-10-01): «Закрепить фоны» — внутри блока динамичной заставки. -->
            <StackPanel DataContext="{Binding Main}" Margin="0,10,0,0">
                <CheckBox ToolTip="Остановить смену картинок слайд-шоу Windows — на каждом мониторе остаётся его текущая картинка" IsChecked="{Binding PinWallpapers}">
                    <TextBlock Text="Закрепить фоны рабочего стола (остановить слайд-шоу)" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="20,0,0,0"
                           Text="Слайд-шоу Windows ставит разные картинки на разные мониторы, но меняет их не реже раза в сутки. С галочкой смена останавливается: на каждом мониторе остаётся та картинка, что сейчас. Снимите галочку — слайд-шоу пойдёт снова из той же папки." />
                <TextBlock Text="{Binding PinWallpapersStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="20,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PinWallpapers}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- ============ Экспорт / импорт: один архив со всеми картинками и настройками обоих режимов. ============ -->
        <TextBlock Text="Перенос на другой компьютер" Style="{StaticResource Style.SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Экспорт" Command="{Binding ExportCommand}" Style="{StaticResource Style.SettingsButton}" Margin="0,4,8,4" Height="32"
                        ToolTip="Сохранить все картинки и настройки заставки и фона одним архивом (по умолчанию — на рабочий стол)" />
                <Button Content="Импорт" Command="{Binding ImportCommand}" Style="{StaticResource Style.SettingsButton}" Height="32"
                        ToolTip="Загрузить картинки и настройки из архива; затем — применить сейчас или только скопировать" />
            </StackPanel>
            <!-- Быстрое открытие этого окна (докладка 2026-10-01): глобальная клавиша, по умолчанию выкл; то же — в «Настройке клавиш». -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" DataContext="{Binding Main}" VerticalAlignment="Center">
                <CheckBox Content="Быстрое открытие этого окна" IsChecked="{Binding BackgroundWindowHotkeyEnabled}" VerticalAlignment="Center"
                          Margin="0,0,10,0" ToolTip="Сочетание справа открывает это окно из любой программы" />
                <c:HotkeyBox BindingValue="{Binding BackgroundWindowKeyShown}" IsEnabled="{Binding BackgroundWindowHotkeyEnabled}" Width="140" Height="32"
                             ToolTip="Сочетание для открытия этого окна. Клик ЛКМ — назначить другое" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding ExchangeStatus}" Style="{StaticResource Style.StatusLine}" Foreground="{StaticResource Brush.TextSecondary}" />
    </StackPanel>
    </ScrollViewer>
</Window>
