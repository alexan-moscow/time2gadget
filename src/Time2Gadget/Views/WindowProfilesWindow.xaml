<Window x:Class="Time2Gadget.Views.WindowProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Time2Gadget.Controls"
        Title="Размер и положение окон программ — Тайм2гаджет"
        Width="900" Height="620" MinWidth="860" MinHeight="540"
        Background="{StaticResource Brush.Background}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <!-- Докладка 2026-09-29 (по образцу Simple Runtime Window Editor): ViewModels/WindowProfilesViewModel. -->
    <Window.Resources>
        <!-- Строка списка окон/профилей — тёмная, выбранная подсвечена акцентом (как в меню быстрых таймеров). -->
        <Style x:Key="Style.ListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="6,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceSectorHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Квадратная кнопка быстрого выравнивания (угол/сторона/центр монитора). -->
        <Style x:Key="Style.AlignButton" TargetType="Button" BasedOn="{StaticResource Style.SettingsButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="Style.Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="Style.NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Margin" Value="4,0,12,0" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <!-- Справа без поля — полоса прокрутки у края окна, как в настройках (докладка 2026-09-29); поле даёт Padding прокрутки. -->
    <Grid x:Name="ContentGrid" Margin="16,16,0,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Окна ============ -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Окна" Style="{StaticResource Style.SectionHeader}" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Style.SettingsButton}" Margin="0,0,6,0"
                        ToolTip="Перечитать список окон и мониторов" />
                <Button Content="{Binding PickButtonText}" Command="{Binding PickWindowCommand}" Style="{StaticResource Style.SettingsButton}"
                        ToolTip="Нажмите и за 3 секунды переключитесь в нужное окно (Alt+Tab) — для игр, которых нет в списке" />
                <TextBlock Text="3 с — Alt+Tab&#x0a;в нужное окно" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <CheckBox DockPanel.Dock="Top" Content="Показать все окна" IsChecked="{Binding ShowAllWindows}" Margin="0,8,0,6"
                      ToolTip="Без фильтров: окна без заголовка, служебные и дочерние — если нужного окна нет в списке" />
            <ListBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" Background="{StaticResource Brush.SurfaceSector}"
                     BorderThickness="0" ItemContainerStyle="{StaticResource Style.ListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <!-- Метка «профиль» (докладка 2026-09-29): к программе постоянно применяется профиль. Контур и текст — цветом
                                 строки, поэтому видна и на выделенной (синей) строке. -->
                            <Border Grid.Column="2" VerticalAlignment="Top" Margin="6,2,0,0" CornerRadius="3" BorderThickness="1" Padding="4,0"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                    Visibility="{Binding HasPermanentProfile, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding PermanentProfile}" ToolTipService.InitialShowDelay="300">
                                <TextBlock Text="профиль" FontSize="10" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ExeName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Title}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ============ Выбранное окно ============ -->
        <ScrollViewer x:Name="RightScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel x:Name="RightPanel">
                <TextBlock Text="Выбранное окно" Style="{StaticResource Style.SectionHeader}" Margin="0,0,0,4" />
                <!-- Имя и текущие параметры, справа — скопировать их в поля ниже (например, выставленное SRWE — и сохранить профилем). -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedHeader}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentText}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding TakeFromWindowCommand}" Style="{StaticResource Style.SettingsButton}"
                            Padding="8,3" Margin="10,0,0,0" FontSize="11" IsEnabled="{Binding HasSelection}"
                            ToolTip="Поля заполняются сами при выборе окна. Если окно с тех пор сдвинули или изменили — перечитать его заново">
                        <TextBlock Text="Перечитать окно" TextAlignment="Center" />
                    </Button>
                </Grid>

                <StackPanel IsEnabled="{Binding HasSelection}">
                    <!-- Монитор: выбор другого монитора сразу переносит окно туда. -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Монитор" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedMonitor}"
                                  MinWidth="230" ToolTip="Выбор другого монитора сразу переносит окно туда (то же положение и размер)" />
                    </StackPanel>

                    <TextBlock Text="Прижать к краю монитора" Style="{StaticResource Style.Caption}" />
                    <StackPanel Orientation="Horizontal">
                        <UniformGrid Rows="3" Columns="3">
                            <Button Content="↖" Command="{Binding AlignCommand}" CommandParameter="TL" Style="{StaticResource Style.AlignButton}" ToolTip="В левый верхний угол" />
                            <Button Content="↑" Command="{Binding AlignCommand}" CommandParameter="T" Style="{StaticResource Style.AlignButton}" ToolTip="Вверх, по центру" />
                            <Button Content="↗" Command="{Binding AlignCommand}" CommandParameter="TR" Style="{StaticResource Style.AlignButton}" ToolTip="В правый верхний угол" />
                            <Button Content="←" Command="{Binding AlignCommand}" CommandParameter="L" Style="{StaticResource Style.AlignButton}" ToolTip="Влево, по центру" />
                            <Button Content="·" Command="{Binding AlignCommand}" CommandParameter="C" Style="{StaticResource Style.AlignButton}" ToolTip="По центру монитора" />
                            <Button Content="→" Command="{Binding AlignCommand}" CommandParameter="R" Style="{StaticResource Style.AlignButton}" ToolTip="Вправо, по центру" />
                            <Button Content="↙" Command="{Binding AlignCommand}" CommandParameter="BL" Style="{StaticResource Style.AlignButton}" ToolTip="В левый нижний угол" />
                            <Button Content="↓" Command="{Binding AlignCommand}" CommandParameter="B" Style="{StaticResource Style.AlignButton}" ToolTip="Вниз, по центру" />
                            <Button Content="↘" Command="{Binding AlignCommand}" CommandParameter="BR" Style="{StaticResource Style.AlignButton}" ToolTip="В правый нижний угол" />
                        </UniformGrid>
                        <StackPanel Margin="12,2,0,0">
                            <Button Content="Во всю высоту слева" Command="{Binding AlignCommand}" CommandParameter="FullLeft" Style="{StaticResource Style.SettingsButton}"
                                    Margin="0,0,0,4" ToolTip="Прижать к левому краю и растянуть по высоте (ширина как в поле)" />
                            <Button Content="Во всю высоту справа" Command="{Binding AlignCommand}" CommandParameter="FullRight" Style="{StaticResource Style.SettingsButton}"
                                    Margin="0,0,0,4" ToolTip="Прижать к правому краю и растянуть по высоте (ширина как в поле)" />
                            <Button Content="Во весь монитор" Command="{Binding AlignCommand}" CommandParameter="Full" Style="{StaticResource Style.SettingsButton}"
                                    Margin="0" ToolTip="Растянуть на всю рабочую область монитора (без панели задач)" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Точные значения: X, Y — левый верхний угол окна. -->
                    <TextBlock Text="Левый верхний угол и размер окна, в пикселях" Style="{StaticResource Style.Caption}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="X" VerticalAlignment="Center" ToolTip="Левый край окна" />
                        <TextBox Text="{Binding X}" Style="{StaticResource Style.NumberBox}" ToolTip="Левый край окна" />
                        <TextBlock Text="Y" VerticalAlignment="Center" ToolTip="Верхний край окна" />
                        <TextBox Text="{Binding Y}" Style="{StaticResource Style.NumberBox}" ToolTip="Верхний край окна" />
                        <TextBlock Text="Ширина" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Width}" Style="{StaticResource Style.NumberBox}" />
                        <TextBlock Text="Высота" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Height}" Style="{StaticResource Style.NumberBox}" />
                    </StackPanel>
                    <!-- Галочки слева, кнопки справа — «Применить» на строке первой галочки, «Сохранить как профиль» на строке
                         второй, одного размера (докладка 2026-09-29). -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <!-- Указатель мыши в окне (докладка 2026-09-29): справа — общая глобальная клавиша «свободен / снова в окне». -->
                        <CheckBox Grid.Row="3" Content="Не выпускать указатель мыши из окна" IsChecked="{Binding ConfineCursor}" VerticalAlignment="Center"
                                  Margin="0,6,0,0" ToolTip="Пока окно активно, указатель не выходит за его границы; другое окно (Alt+Tab) — свободен" />
                        <c:HotkeyBox Grid.Row="3" Grid.Column="1" BindingValue="{Binding CursorConfineKey}" Width="150" Margin="12,8,0,2"
                                     ToolTip="Сочетание: указатель свободен / снова в окне (для всех таких окон). Щелчок — назначить другое: с Ctrl/Shift/Alt/Win или кнопкой мыши" />
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="20,0,0,0"
                                   Text="Пока окно активно, указатель не выходит за его границы. Сочетание справа временно освобождает указатель и снова ограничивает его." />
                        <CheckBox Content="Без рамки и заголовка" IsChecked="{Binding Borderless}" VerticalAlignment="Center"
                                  ToolTip="Снять с окна рамку и заголовок — «окно без рамки», как «Remove borders» в SRWE" />
                        <CheckBox Grid.Row="1" Content="Сообщать программе, что размер изменён" IsChecked="{Binding NotifyResize}" VerticalAlignment="Center"
                                  ToolTip="После смены размера послать сигнал «размер изменён» (WM_EXITSIZEMOVE)" />
                        <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="20,0,0,0"
                                   Text="Нужно играм: без этого часть игр продолжает рисовать картинку в старом размере." />
                        <!-- Мелко в две строки — кнопки не широкие (докладка 2026-09-29). -->
                        <Button Grid.Column="1" Command="{Binding ApplyCommand}" Style="{StaticResource Style.SettingsButton}"
                                Width="150" Padding="6,3" FontSize="11" Margin="12,2,0,2" ToolTip="Поставить окно по значениям выше">
                            <TextBlock Text="Применить текущие&#x0a;настройки" TextAlignment="Center" />
                        </Button>
                        <Button x:Name="SaveProfileButton" Grid.Row="1" Grid.Column="1" Command="{Binding OpenSaveProfileCommand}"
                                Style="{StaticResource Style.SettingsButton}" Width="150" Padding="6,3" FontSize="11" Margin="12,2,0,2"
                                ToolTip="Сохранить значения выше в профиль — выбранный или новый; профиль можно применять к любым окнам">
                            <TextBlock Text="Сохранить" TextAlignment="Center" />
                        </Button>
                        <!-- Сохранение (докладка 2026-09-29) — диалог строками: профиль выбран — «Сохранить в «X»?» [В текущий профиль]
                             [В новый профиль] [Отмена], «В новый» добавляет строку имени; не выбран — сразу строка имени, ниже приглушённо
                             «или перезаписать профиль»: список + [Сохранить] → «Перезаписать «X»?» [Да] [Отмена]. Правый край — по кнопке. -->
                        <Popup PlacementTarget="{Binding ElementName=SaveProfileButton}" Placement="Bottom" HorizontalOffset="-330"
                               StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsSavePopupOpen, Mode=TwoWay}">
                            <Border Padding="8" CornerRadius="6" BorderThickness="1" Margin="0,2,0,0" Width="480"
                                    Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.BorderSubtle}">
                                <StackPanel>
                                    <Grid Visibility="{Binding SaveShowChoice, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Куда сохранить?" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="В текущий профиль" Command="{Binding SaveToSelectedCommand}" Style="{StaticResource Style.SettingsButton}"
                                                Margin="6,0,0,0" Padding="8,5" ToolTip="{Binding SaveChoiceText}" />
                                        <Button Grid.Column="2" Content="В новый профиль" Command="{Binding SaveAsNewCommand}" Style="{StaticResource Style.SettingsButton}"
                                                Margin="6,0,0,0" Padding="8,5" ToolTip="Сохранить как новый профиль — ниже появится поле для имени" />
                                        <Button Grid.Column="3" Content="Отмена" Command="{Binding CancelSaveCommand}" Style="{StaticResource Style.SettingsButton}"
                                                Margin="6,0,0,0" Padding="8,5" IsCancel="True" />
                                    </Grid>
                                    <Grid Visibility="{Binding SaveShowName, Converter={StaticResource BoolToVis}}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SaveShowChoice}" Value="True">
                                                        <Setter Property="Margin" Value="0,8,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Новый профиль:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                                 ToolTip="Имя предложено по значениям — можно вписать своё" />
                                        <Button Grid.Column="2" Content="{Binding SaveNewButtonText}" Command="{Binding SaveProfileCommand}" Style="{StaticResource Style.SettingsButton}"
                                                Margin="6,0,0,0" Padding="8,5" IsDefault="True" MaxWidth="200"
                                                ToolTip="Сохранить значения как профиль с этим именем (имя существующего профиля — перезаписать его)" />
                                    </Grid>
                                    <!-- «В фоне»: приглушено, пока на него не навели. -->
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding SaveShowOverwrite, Converter={StaticResource BoolToVis}}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="0.6" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="или в профиль:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextSecondary}" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding OverwriteTarget}"
                                                      ToolTip="Выбрать профиль, в который сохранить значения выше">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="2" Content="Сохранить" Command="{Binding AskOverwriteCommand}" Style="{StaticResource Style.SettingsButton}"
                                                    Margin="6,0,0,0" Padding="8,5" IsEnabled="{Binding HasOverwriteTarget}" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0" Visibility="{Binding IsOverwriteConfirm, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding OverwriteQuestion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding OverwriteQuestion}" />
                                            <Button Grid.Column="1" Content="Да" Command="{Binding ConfirmOverwriteCommand}" Style="{StaticResource Style.SettingsButton}"
                                                    Margin="6,0,0,0" Padding="14,5" />
                                            <Button Grid.Column="2" Content="Отмена" Command="{Binding CancelOverwriteCommand}" Style="{StaticResource Style.SettingsButton}"
                                                    Margin="6,0,0,0" Padding="8,5" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- ============ Профили (докладка 2026-09-29): строка 1 — список во всю ширину + «Убрать профиль»;
                     строка 2 — «Применить», «Применять постоянно», «Переименовать», «✕» на всю ширину. ============ -->
                <StackPanel IsEnabled="{Binding HasSelection}">
                    <TextBlock Text="Профили" Style="{StaticResource Style.SectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <!-- Длинное имя — обрезается многоточием, целиком — в подсказке (в раскрытом списке видно полностью). -->
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      ToolTip="{Binding SelectedProfile.Name, FallbackValue='Сохранённые профили — применяются к любому окну'}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding ProfilePlaceholder}" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}" Opacity="0.8" FontStyle="Italic" />
                        </Grid>
                        <Button Grid.Column="1" Content="Убрать профиль" Command="{Binding ClearProfileCommand}" Style="{StaticResource Style.SettingsButton}"
                                Width="150" Margin="12,4,0,4" IsEnabled="{Binding HasProfile}"
                                ToolTip="Сбросить выбор на «Выберите профиль» (профиль не удаляется и продолжает применяться, где включено)" />
                    </Grid>
                    <!-- Кнопки делят ширину поровну, «✕» — узкий, по правому краю (как «Убрать профиль» выше). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Применить" Command="{Binding ApplyProfileCommand}" Style="{StaticResource Style.SettingsButton}"
                                Margin="0,4,0,4" IsEnabled="{Binding HasProfile}" ToolTip="Поставить окно по выбранному профилю" />
                        <!-- Переключатель: включён — профиль применяется к этой программе сам; повторное нажатие — выключить. -->
                        <ToggleButton Grid.Column="1" IsChecked="{Binding ApplyPermanently}" IsEnabled="{Binding HasProfile}" Margin="6,4,0,4"
                                      ToolTip="{Binding ApplyPermanentlyToolTip}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Content" Value="Применять постоянно" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceSector}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="12,6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceSectorHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="✔ Применяется постоянно" />
                                            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Button x:Name="RenameProfileButton" Grid.Column="2" Content="Переименовать" Command="{Binding OpenRenameCommand}"
                                Style="{StaticResource Style.SettingsButton}" Margin="6,4,0,4" IsEnabled="{Binding HasProfile}"
                                ToolTip="Дать выбранному профилю другое имя" />
                        <Button Grid.Column="3" Content="✕" Command="{Binding DeleteProfileCommand}" Style="{StaticResource Style.SettingsButton}"
                                Margin="6,4,0,4" Padding="12,6" IsEnabled="{Binding HasProfile}" ToolTip="Удалить выбранный профиль" />
                        <!-- Новое имя — всплывает у кнопки, с текущим именем. -->
                        <Popup PlacementTarget="{Binding ElementName=RenameProfileButton}" Placement="Bottom" HorizontalOffset="-150"
                               StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsRenamePopupOpen, Mode=TwoWay}">
                            <Border Padding="8" CornerRadius="6" BorderThickness="1" Margin="0,2,0,0" Width="340"
                                    Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.BorderSubtle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding RenameHint}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="1" Content="Переименовать" Command="{Binding RenameCommand}" Style="{StaticResource Style.SettingsButton}"
                                                Margin="6,0,0,0" IsDefault="True" IsEnabled="{Binding CanRename}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0"
                               Text="Один профиль можно применять к любому числу программ. Если изменить окно вручную (кнопки, монитор, «Применить»), постоянное применение просто выключится." />

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
