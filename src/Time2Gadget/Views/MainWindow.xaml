<Window x:Class="Time2Gadget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:Time2Gadget.Controls"
        mc:Ignorable="d"
        Title="Тайм2гаджет"
        Width="273" Height="341"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing"
        Loaded="OnWindowLoaded">

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding StartPauseCommand}" />
        <KeyBinding Key="R" Command="{Binding ResetCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ResetCommand}" />
    </Window.InputBindings>

    <Border x:Name="Chrome" CornerRadius="28" Background="{StaticResource Brush.Background}" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>
        <Grid x:Name="RootGrid" Background="Transparent"
              MouseLeftButtonDown="OnRootMouseLeftButtonDown"
              MouseMove="OnRootMouseMove"
              MouseLeftButtonUp="OnRootMouseLeftButtonUp"
              MouseWheel="OnRootMouseWheel">

            <!-- ============================================================
                 NORMAL — круговая композиция. Единый отступ 16px со всех сторон
                 (кольцо/центр сверху+по бокам, кнопки снизу) — docs/DECISIONS.md,
                 находка от 2026-09-27 ("лишние padding по ушам").
                 ============================================================ -->
            <Grid x:Name="NormalContent">

                <!-- RingGroup — общий контейнер для кольца И центрального дисплея: оба ребёнка
                     Center/Center внутри ОДНОЙ ячейки Grid, поэтому центр времени гарантированно
                     совпадает с геометрическим центром колец при любых будущих изменениях радиусов
                     (докладка 2026-09-27: раньше центрирование считалось отдельными Margin на разной
                     высоте у RingGroup/CenterDisplay и расходилось). Pulse-эффект применяется только
                     к RingVisuals (кольца), не к тексту времени. -->
                <Grid x:Name="RingGroup" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">

                    <Grid x:Name="RingVisuals" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="RingGroupScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <!-- Визуальный эффект циферблата (Pulse/Flash/ColorBreathe, по умолчанию отключён) —
                             один общий overlay-элемент, см. MainWindow.xaml.cs → ApplyRunningEffect. -->
                        <Ellipse x:Name="EffectOverlay" Width="225" Height="225" Fill="{StaticResource Brush.Accent}"
                                 Opacity="0" IsHitTestVisible="False" />

                        <controls:SectorRingControl x:Name="SectorRing"
                                                     OuterRadius="108" InnerRadius="84"
                                                     Presets="{Binding Presets}"
                                                     SelectedPreset="{Binding SelectedPreset}"
                                                     SelectCommand="{Binding SelectPresetCommand}" />

                        <controls:ProgressRingControl x:Name="ProgressRing"
                                                       OuterRadius="78" InnerRadius="74"
                                                       ProgressFraction="{Binding ProgressFraction}"
                                                       IsFinished="{Binding IsFinished}" />
                    </Grid>

                    <!-- Кликабельная зона центра — строго внутри "дыры" колец (не перекрывает сектора).
                         Клик без движения мыши переключает Compact-режим (docs/UI-CONTRACT.md, обновлено
                         2026-09-27); движение мыши от этой же точки — перетаскивание окна, см. .xaml.cs. -->
                    <Border x:Name="CenterDisplay" Width="142" Height="142" Background="Transparent" controls:HintService.Key="Center"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Сегментный циферблат: подложка из погасших сегментов + горящие цифры.
                                 Viewbox DownOnly — длинный формат H:MM:SS ужимается в ту же ширину. -->
                            <Viewbox x:Name="TimeText" MaxWidth="118" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                <Grid>
                                    <controls:SegmentTimeText Style="{StaticResource Style.SegmentGhost}" IsGhost="True"
                                                              Time="{Binding RemainingTime}" />
                                    <controls:SegmentTimeText Style="{StaticResource Style.SegmentDigits}"
                                                              Time="{Binding RemainingTime}" IsColonLit="{Binding IsColonLit}" />
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Style.StatusLabel}" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Управление: Mute(+громкость) / Start-Pause / Reset -->
                <StackPanel x:Name="ControlsRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Slider Style="{StaticResource Style.ThinVolumeSliderVertical}" Minimum="0" Maximum="1"
                                Value="{Binding AlarmVolume}" Height="40" Margin="0,0,6,0" controls:HintService.Key="Volume" />
                        <!-- Иконки — векторные Path в Canvas 24x24 внутри Viewbox (как угловые кнопки):
                             точный центр в круге при любом размере. Иконка ≈ половина диаметра кнопки. -->
                        <Button Style="{StaticResource Style.CircleButton}" Command="{Binding ToggleMuteCommand}" controls:HintService.Key="Mute">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding IsMuted, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.VolumeOff|Geometry.VolumeUp}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource Style.PrimaryCircleButton}" Command="{Binding StartPauseCommand}"
                            Margin="0,0,14,0" controls:HintService.Key="StartPause">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding IsRunning, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.Pause|Geometry.Play}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource Style.CircleButton}" Command="{Binding ResetCommand}" controls:HintService.Key="Reset">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Geometry.Refresh}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================
                 COMPACT — скруглённый прямоугольник (не круг), докладка 2026-09-27.
                 ============================================================ -->
            <Border x:Name="CompactContent" CornerRadius="20" Background="{StaticResource Brush.SurfaceSector}"
                    Width="220" Height="140" Visibility="Collapsed">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="CompactCenterDisplay" Grid.Row="0" Background="Transparent" controls:HintService.Key="CompactCenter"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Тот же сегментный циферблат; фиксированная высота — ширины в компакте хватает и на H:MM:SS. -->
                            <Viewbox x:Name="CompactTimeText" Height="30" HorizontalAlignment="Center">
                                <Grid>
                                    <controls:SegmentTimeText Style="{StaticResource Style.SegmentGhost}" IsGhost="True"
                                                              Time="{Binding RemainingTime}" />
                                    <controls:SegmentTimeText Style="{StaticResource Style.SegmentDigits}"
                                                              Time="{Binding RemainingTime}" IsColonLit="{Binding IsColonLit}" />
                                </Grid>
                            </Viewbox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Height="4" CornerRadius="2" Background="{StaticResource Brush.BorderSubtle}"
                            Margin="0,10" ClipToBounds="True">
                        <Border x:Name="CompactProgressBar" Width="0" HorizontalAlignment="Left"
                                Background="{StaticResource Brush.Accent}" CornerRadius="2" />
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Slider Style="{StaticResource Style.ThinVolumeSliderVertical}" Minimum="0" Maximum="1"
                                    Value="{Binding AlarmVolume}" Height="32" Margin="0,0,6,0" controls:HintService.Key="Volume" />
                            <Button Style="{StaticResource Style.CircleButton}" Width="32" Height="32"
                                    Command="{Binding ToggleMuteCommand}" controls:HintService.Key="Mute">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding IsMuted, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.VolumeOff|Geometry.VolumeUp}"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource Style.PrimaryCircleButton}" Width="40" Height="40"
                                Command="{Binding StartPauseCommand}" Margin="0,0,10,0" controls:HintService.Key="StartPause">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding IsRunning, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.Pause|Geometry.Play}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource Style.CircleButton}" Width="32" Height="32"
                                Command="{Binding ResetCommand}" controls:HintService.Key="Reset">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Geometry.Refresh}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================
                 Верхние угловые кнопки (замена системной рамки — docs/UI-CONTRACT.md):
                 шестерёнка (настройки) слева, закрыть/свернуть справа.
                 ============================================================ -->
            <Button x:Name="SettingsButton" Style="{StaticResource Style.CornerIconButton}"
                    Command="{Binding OpenSettingsCommand}" controls:HintService.Key="Settings"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Geometry.Gear}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Переключатель «после таймера закрыть/свернуть» (что именно — по настройке закрытия).
                 Выкл — приглушённая иконка, вкл — акцентная. Размер/стиль — как у крестика. -->
            <Button x:Name="AutoCloseButton" Style="{StaticResource Style.CornerIconButton}"
                    Command="{Binding ToggleAutoCloseCommand}" controls:HintService.Key="AutoClose"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,42,0">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Geometry.Power}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource Brush.TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutoCloseAfterFinish}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button x:Name="CloseButton" Style="{StaticResource Style.CornerIconButton}"
                    Click="OnCloseButtonClick" controls:HintService.Key="Close"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Geometry.Close}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</Window>
