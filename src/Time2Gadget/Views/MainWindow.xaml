<Window x:Class="Time2Gadget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:Time2Gadget.Controls"
        mc:Ignorable="d"
        Title="Тайм2гаджет"
        Width="273" Height="341"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <!-- Дата компакта «ДД . ММ . ГГ» сегментным шрифтом: каждая пара цифр — с подложкой «88», точки разнесены
             отступами (слитно в DSEG читалось плохо, докладка 2026-09-27). Размер наследует FontSize ContentControl. -->
        <ControlTemplate x:Key="CompactDateTemplate" TargetType="ContentControl">
            <StackPanel Orientation="Horizontal" TextElement.FontSize="{TemplateBinding FontSize}">
                <Grid>
                    <TextBlock Text="88" Style="{StaticResource Style.ClockGhost}" FontSize="{TemplateBinding FontSize}" />
                    <TextBlock Text="{Binding DateDay}" Style="{StaticResource Style.ClockText}" FontSize="{TemplateBinding FontSize}" />
                </Grid>
                <TextBlock Text="." Style="{StaticResource Style.ClockText}" FontSize="{TemplateBinding FontSize}" Margin="3,0" />
                <Grid>
                    <TextBlock Text="88" Style="{StaticResource Style.ClockGhost}" FontSize="{TemplateBinding FontSize}" />
                    <TextBlock Text="{Binding DateMonth}" Style="{StaticResource Style.ClockText}" FontSize="{TemplateBinding FontSize}" />
                </Grid>
                <TextBlock Text="." Style="{StaticResource Style.ClockText}" FontSize="{TemplateBinding FontSize}" Margin="3,0" />
                <Grid>
                    <TextBlock Text="88" Style="{StaticResource Style.ClockGhost}" FontSize="{TemplateBinding FontSize}" />
                    <TextBlock Text="{Binding DateYear}" Style="{StaticResource Style.ClockText}" FontSize="{TemplateBinding FontSize}" />
                </Grid>
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>


    <!-- Тень — отдельным слоем позади окна (докладка 2026-10-02): эффект на самом окне заставлял перерисовывать всё его содержимое
         шейдером тени в каждом кадре любой анимации (волны, змейка) — 15–20% видеокарты у маленького окна. Слой тени не меняется. -->
    <Grid Margin="8">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ViewScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Border CornerRadius="28" Background="{StaticResource Brush.Background}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="24" ShadowDepth="0" />
            </Border.Effect>
        </Border>
    <Border x:Name="Chrome" CornerRadius="28" Background="{StaticResource Brush.Background}">
        <!-- Масштаб вида — ползунки «Размер полного/компактного вида» (MainWindow.xaml.cs → ApplyModeLayout).
             LayoutTransform: вся вёрстка векторная, при увеличении остаётся чёткой. -->

        <Grid x:Name="RootGrid" Background="Transparent"
              MouseLeftButtonDown="OnRootMouseLeftButtonDown"
              MouseMove="OnRootMouseMove"
              MouseLeftButtonUp="OnRootMouseLeftButtonUp"
              MouseWheel="OnRootMouseWheel">

            <!-- ============================================================
                 NORMAL — круговая композиция. Единый отступ 16px со всех сторон
                 (кольцо/центр сверху+по бокам, кнопки снизу) — docs/DECISIONS.md,
                 находка от 2026-09-27 ("лишние padding по ушам").
                 ============================================================ -->
            <Grid x:Name="NormalContent">

                <!-- «Змейка» / «Радужная змейка» по рамке окна (докладка 2026-09-28) — размер = содержимое полного вида. -->
                <Rectangle x:Name="FrameSnake" Width="257" Height="325" RadiusX="28" RadiusY="28" StrokeDashCap="Round"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />

                <!-- RingGroup — общий контейнер для кольца И центрального дисплея: оба ребёнка
                     Center/Center внутри ОДНОЙ ячейки Grid, поэтому центр времени гарантированно
                     совпадает с геометрическим центром колец при любых будущих изменениях радиусов
                     (докладка 2026-09-27: раньше центрирование считалось отдельными Margin на разной
                     высоте у RingGroup/CenterDisplay и расходилось). Pulse-эффект применяется только
                     к RingVisuals (кольца), не к тексту времени. -->
                <Grid x:Name="RingGroup" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">

                    <Grid x:Name="RingVisuals" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="RingGroupScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <!-- Визуальный эффект циферблата (Pulse/Flash/ColorBreathe, по умолчанию отключён) —
                             один общий overlay-элемент, см. MainWindow.xaml.cs → ApplyRunningEffect. -->
                        <Ellipse x:Name="EffectOverlay" Width="225" Height="225" Fill="{StaticResource Brush.Accent}"
                                 Opacity="0" IsHitTestVisible="False" />

                        <controls:SectorRingControl x:Name="SectorRing"
                                                     OuterRadius="108" InnerRadius="84"
                                                     Presets="{Binding Presets}"
                                                     SelectedPreset="{Binding SelectedPreset}"
                                                     SelectCommand="{Binding SelectPresetCommand}" />

                        <!-- «Встречные волны» (докладка 2026-09-28): два размытых контура по полосе секторов (84..108),
                             бегущий пунктир навстречу друг другу с разной скоростью — MainWindow.xaml.cs → RunDashLoop. -->
                        <Ellipse x:Name="WaveRingA" Width="216" Height="216" StrokeThickness="24" Opacity="0.55"
                                 Visibility="Collapsed" IsHitTestVisible="False">
                            <Ellipse.Effect><BlurEffect Radius="8" /></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="WaveRingB" Width="216" Height="216" StrokeThickness="24" Opacity="0.45"
                                 Visibility="Collapsed" IsHitTestVisible="False">
                            <Ellipse.Effect><BlurEffect Radius="8" /></Ellipse.Effect>
                        </Ellipse>

                        <controls:ProgressRingControl x:Name="ProgressRing"
                                                       OuterRadius="78" InnerRadius="74"
                                                       ProgressFraction="{Binding ProgressFraction}"
                                                       IsFinished="{Binding IsFinished}" />
                    </Grid>

                    <!-- Кликабельная зона центра — строго внутри "дыры" колец (не перекрывает сектора).
                         Клик без движения мыши переключает Compact-режим (docs/UI-CONTRACT.md, обновлено
                         2026-09-27); движение мыши от этой же точки — перетаскивание окна, см. .xaml.cs. -->
                    <Border x:Name="CenterDisplay" Width="142" Height="142" Background="Transparent" controls:HintService.Key="Center"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Сегментный циферблат: подложка из погасших сегментов + горящие цифры.
                                 Viewbox DownOnly — длинный формат H:MM:SS ужимается в ту же ширину. -->
                            <Viewbox x:Name="TimeText" MaxWidth="118" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                <Grid>
                                    <controls:SegmentTimeText Style="{StaticResource Style.SegmentGhost}" IsGhost="True"
                                                              Time="{Binding RemainingTime}" />
                                    <controls:SegmentTimeText Style="{StaticResource Style.SegmentDigits}"
                                                              Time="{Binding RemainingTime}" IsColonLit="{Binding IsColonLit}" />
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Style.StatusLabel}" Margin="0,7,0,0" />
                            <!-- Часы (сегментным шрифтом, как таймер) и дата (шрифтом статуса) под тонким
                                 разделителем — каждое по своей настройке (докладка 2026-09-27). -->
                            <StackPanel Visibility="{Binding IsClockAreaVisible, Converter={StaticResource BoolToVis}}">
                                <!-- Отступы подобраны по замеру пикселей (2026-09-27): видимый зазор над линией 8px, под ней 7px
                                     (было 9/6); общее расстояние «ОСТАЛОСЬ» → часы прежнее. -->
                                <Border Style="{StaticResource Style.ClockSeparator}" Width="84" Margin="0,5,0,6" />
                                <Grid HorizontalAlignment="Center" Visibility="{Binding ShowClock, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ClockGhostText}" Style="{StaticResource Style.ClockGhost}" />
                                    <TextBlock Text="{Binding ClockText}" Style="{StaticResource Style.ClockText}" />
                                </Grid>
                                <TextBlock Text="{Binding DateText}" Style="{StaticResource Style.DateText}" Margin="0,4,0,0"
                                           Visibility="{Binding ShowDate, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Управление: Mute / Start-Pause / Reset — симметричная тройка, Start-Pause точно под центром
                     циферблата (докладка 2026-09-27). Громкость — снаружи тройки, слева от Mute (отрицательный
                     отступ), поэтому не сдвигает центровку; размеры/зазор 6px — прежние. -->
                <Grid x:Name="ControlsRow" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
                    <Slider Style="{StaticResource Style.ThinVolumeSliderVertical}" Minimum="0" Maximum="1"
                            Value="{Binding AlarmVolume}" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="-20,0,0,0" controls:HintService.Key="Volume" />
                    <StackPanel Orientation="Horizontal">
                        <!-- Иконки — векторные Path в Canvas 24x24 внутри Viewbox (как угловые кнопки):
                             точный центр в круге при любом размере. Иконка ≈ половина диаметра кнопки. -->
                        <Button Style="{StaticResource Style.CircleButton}" Command="{Binding ToggleMuteCommand}" controls:HintService.Key="Mute"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding IsMuted, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.VolumeOff|Geometry.VolumeUp}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    <Button Style="{StaticResource Style.PrimaryCircleButton}" Command="{Binding StartPauseCommand}"
                            Margin="0,0,14,0" controls:HintService.Key="StartPause">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding IsRunning, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.Pause|Geometry.Play}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource Style.CircleButton}" Command="{Binding ResetCommand}" controls:HintService.Key="Reset">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Geometry.Refresh}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============================================================
                 COMPACT — скруглённый прямоугольник (не круг), докладка 2026-09-27.
                 ============================================================ -->
            <Border x:Name="CompactContent" CornerRadius="20" Background="{StaticResource Brush.SurfaceSector}"
                    Width="220" Height="132" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"><!-- 132 — подобрано замером: без лишнего зазора над полоской (2026-09-27) -->
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CompactScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Grid>
                <!-- Эффекты отсчёта/завершения в компакте (докладка 2026-09-27: раньше были только на кольце
                     полного режима и в компакте не было видно). Анимируются вместе с EffectOverlay — см. .xaml.cs. -->
                <Border x:Name="CompactEffectOverlay" CornerRadius="20" Opacity="0" IsHitTestVisible="False" />
                <!-- Волны и змейка компакта — по краю прямоугольника (докладка 2026-09-28). -->
                <Rectangle x:Name="CompactWaveA" Width="220" Height="132" RadiusX="20" RadiusY="20" StrokeThickness="4" Opacity="0.7"
                           Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle.Effect><BlurEffect Radius="3" /></Rectangle.Effect>
                </Rectangle>
                <Rectangle x:Name="CompactWaveB" Width="220" Height="132" RadiusX="20" RadiusY="20" StrokeThickness="4" Opacity="0.55"
                           Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle.Effect><BlurEffect Radius="3" /></Rectangle.Effect>
                </Rectangle>
                <Rectangle x:Name="CompactSnake" Width="220" Height="132" RadiusX="20" RadiusY="20" StrokeDashCap="Round"
                           Visibility="Collapsed" IsHitTestVisible="False" />
                <Grid Margin="12,10,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="CompactCenterDisplay" Grid.Row="0" Background="Transparent" controls:HintService.Key="CompactCenter"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <!-- Прижато к полоске хода: дата/строка часов стоит сразу над ней (докладка 2026-09-27).
                             Часы в покое без даты — посередине свободной высоты (иначе «прилипают» к полоске). -->
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CenterCompactDisplay}" Value="True">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- Крупный блок на всю ширину между угловыми кнопками (146px, пропорции шрифта сохраняются):
                                 таймер, либо — когда таймер не запущен и часы включены — текущее время (докладка 2026-09-27). -->
                            <Grid>
                                <Viewbox x:Name="CompactTimeText" Width="146" MaxHeight="46" Stretch="Uniform"
                                         Visibility="{Binding IsTimerDisplay, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <controls:SegmentTimeText Style="{StaticResource Style.SegmentGhost}" IsGhost="True"
                                                                  Time="{Binding RemainingTime}" />
                                        <controls:SegmentTimeText Style="{StaticResource Style.SegmentDigits}"
                                                                  Time="{Binding RemainingTime}" IsColonLit="{Binding IsColonLit}" />
                                    </Grid>
                                </Viewbox>
                                <Viewbox Width="146" MaxHeight="46" Stretch="Uniform"
                                         Visibility="{Binding IsIdleClock, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <TextBlock Text="{Binding ClockGhostText}" Style="{StaticResource Style.SegmentGhost}" />
                                        <TextBlock Text="{Binding ClockText}" Style="{StaticResource Style.SegmentDigits}" />
                                    </Grid>
                                </Viewbox>
                            </Grid>
                            <!-- Режим часов: дата с годом под крупным временем (если дата выключена — места не занимает). -->
                            <ContentControl Template="{StaticResource CompactDateTemplate}" FontSize="13"
                                            HorizontalAlignment="Center" Margin="0,5,0,0" Focusable="False"
                                            Visibility="{Binding ShowIdleDate, Converter={StaticResource BoolToVis}}" />
                            <Border Style="{StaticResource Style.ClockSeparator}" Width="120" Margin="0,5,0,4"
                                    Visibility="{Binding ShowCompactSeparator, Converter={StaticResource BoolToVis}}" />
                            <!-- Режим таймера: часы и дата (с годом) В ОДНУ СТРОКУ по центру. DSEG моноширинный —
                                 при секундах строка не «ездит»; сдвиг возможен только при смене даты. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Visibility="{Binding ShowCompactClockRow, Converter={StaticResource BoolToVis}}">
                                <!-- Размер как у даты в режиме часов (13), докладка 2026-09-27. -->
                                <Grid VerticalAlignment="Center" Visibility="{Binding ShowClock, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ClockGhostText}" Style="{StaticResource Style.ClockGhost}" FontSize="13" />
                                    <TextBlock Text="{Binding ClockText}" Style="{StaticResource Style.ClockText}" FontSize="13" />
                                </Grid>
                                <ContentControl Template="{StaticResource CompactDateTemplate}" FontSize="13" Focusable="False"
                                                VerticalAlignment="Center" Margin="12,0,0,0"
                                                Visibility="{Binding ShowDate, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Height="4" CornerRadius="2" Background="{StaticResource Brush.BorderSubtle}"
                            Margin="0,4,0,8" ClipToBounds="True"><!-- сверху 4: дата/строка часов почти вплотную (2026-09-27) -->
                        <Border x:Name="CompactProgressBar" Width="0" HorizontalAlignment="Left"
                                Background="{StaticResource Brush.Accent}" CornerRadius="2" />
                    </Border>

                    <!-- Как в полном режиме: Play/Pause по центру, Mute/Reset по бокам, громкость снаружи слева.
                         Кнопки — компактные скруглённые прямоугольники (докладка 2026-09-27), иконки прежние. -->
                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                    <Slider Style="{StaticResource Style.ThinVolumeSliderVertical}" Minimum="0" Maximum="1"
                            Value="{Binding AlarmVolume}" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="-22,0,0,0" controls:HintService.Key="Volume" />
                    <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Style.RectButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Command="{Binding ToggleMuteCommand}" controls:HintService.Key="Mute">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding IsMuted, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.VolumeOff|Geometry.VolumeUp}"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        <Button Style="{StaticResource Style.PrimaryRectButton}"
                                Command="{Binding StartPauseCommand}" Margin="0,0,8,0" controls:HintService.Key="StartPause">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding IsRunning, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.Pause|Geometry.Play}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource Style.RectButton}" VerticalAlignment="Center"
                                Command="{Binding ResetCommand}" controls:HintService.Key="Reset">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Geometry.Refresh}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                    </Grid>
                </Grid>
                </Grid>
            </Border>

            <!-- ============================================================
                 Верхние угловые кнопки (замена системной рамки — docs/UI-CONTRACT.md):
                 шестерёнка (настройки) слева, закрыть/свернуть справа.
                 ============================================================ -->
            <Button x:Name="SettingsButton" Style="{StaticResource Style.CornerIconButton}"
                    Command="{Binding OpenSettingsCommand}" controls:HintService.Key="Settings"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <!-- Найдено обновление — шестерёнка жёлтая и мигает, пока его не поставят (2026-09-27). -->
                        <Path Data="{StaticResource Geometry.Gear}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.UpdateAccent}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="UpdateBlink">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3"
                                                                         Duration="0:0:0.7" AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="UpdateBlink" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Переключатель «после таймера закрыть/свернуть» (что именно — по настройке закрытия).
                 Выкл — приглушённая иконка, вкл — акцентная. Размер/стиль — как у крестика. -->
            <Button x:Name="AutoCloseButton" Style="{StaticResource Style.CornerIconButton}"
                    Command="{Binding ToggleAutoCompactCommand}" MouseRightButtonUp="OnAutoCloseRightClick" controls:HintService.Key="AutoClose"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,32,0"><!-- вплотную к крестику (зазор иконок ~6px) -->
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Geometry.Power}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource Brush.TextSecondary}" />
                                    <Style.Triggers>
                                        <!-- ЛКМ — после окончания компактный вид (синий); ПКМ — свернуть в трей/закрыть (приглушённый красный). -->
                                        <DataTrigger Binding="{Binding AutoCompactAfterFinish}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AutoCloseAfterFinish}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.AutoClose}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button x:Name="CloseButton" Style="{StaticResource Style.CornerIconButton}"
                    Click="OnCloseButtonClick" controls:HintService.Key="Close"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Geometry.Close}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </Border>
    </Grid>
</Window>
