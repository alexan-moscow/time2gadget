<Window x:Class="Time2Gadget.Views.ImportMonitorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт заставки и фона — Тайм2гаджет"
        Width="640" SizeToContent="Height" MinWidth="520"
        Background="{StaticResource Brush.Background}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!-- Докладка 2026-10-01: ViewModels/ImportMonitorsViewModel. -->
    <StackPanel Margin="16">
        <TextBlock Text="Куда перенести настройки мониторов" Style="{StaticResource Style.SectionHeader}" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,10"
                   Text="Для каждого монитора из архива выберите, на какой монитор этого компьютера перенести его настройки. Картинки копируются в папку программы в любом случае." />
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Contents}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                                  VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Click="OnCancel" IsCancel="True" Style="{StaticResource Style.SettingsButton}" Height="34" Padding="14,0" Margin="0,0,6,0" />
            <Button Content="Только скопировать" Click="OnCopyOnly" Style="{StaticResource Style.SettingsButton}" Height="34" Padding="14,0" Margin="0,0,6,0"
                    ToolTip="Картинки и настройки скопировать, оба режима оставить выключенными" />
            <Button Content="Применить сейчас" Click="OnApply" IsDefault="True" Style="{StaticResource Style.SettingsButton}" Height="34" Padding="14,0" Margin="0"
                    ToolTip="Скопировать и сразу включить режим, который был включён при экспорте" />
        </StackPanel>
    </StackPanel>
</Window>
