<Window x:Class="Time2Gadget.Views.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Time2Gadget.Models"
        Title="Панель быстрых таймеров — Тайм2гаджет"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="{Binding QuickPanelTopmost}">
    <!-- Докладка 2026-10-01: панель быстрых таймеров (ViewModels/MainViewModel.QuickPanel). Цвета — как у компактного вида,
         скругления на ~30% меньше (20/14 вместо 28/20). Размер — по содержимому: высота по числу таймеров, ширина по самому
         длинному имени (до 15 знаков) и времени (с днями — шире). Перетаскивание — за любое место, пока не закреплена. -->
    <Window.Resources>
        <Style x:Key="Style.PanelButton" TargetType="Button" BasedOn="{StaticResource Style.RectButton}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceSectorHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Chrome" CornerRadius="20" Background="{StaticResource Brush.Background}" Margin="8"
            MouseLeftButtonDown="OnChromeMouseLeftButtonDown">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="ViewScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>
        <Border CornerRadius="14" Background="{StaticResource Brush.SurfaceSector}" MinWidth="180">
            <StackPanel Margin="10,4,10,8">
                <!-- Заголовок справа: надпись, «поверх всех окон / закрепить», крестик -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-4,2">
                    <TextBlock Text="Быстрые таймеры" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Style="{StaticResource Style.PanelButton}" Width="16" Height="14" Background="Transparent"
                            Command="{Binding ToggleQuickPanelTopmostCommand}" ToolTip="{Binding QuickPanelWindowToolTip}">
                        <Button.InputBindings>
                            <MouseBinding Gesture="RightClick" Command="{Binding ToggleQuickPanelPinnedCommand}" />
                        </Button.InputBindings>
                        <Grid Width="10" Height="10">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Border x:Name="TopHalf" CornerRadius="2,2,0,0" BorderThickness="1,1,1,0.5" BorderBrush="{StaticResource Brush.TextSecondary}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QuickPanelTopmost}" Value="True">
                                                <Setter Property="Background" Value="#00C853" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Grid.Row="1" CornerRadius="0,0,2,2" BorderThickness="1,0.5,1,1" BorderBrush="{StaticResource Brush.TextSecondary}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QuickPanelPinned}" Value="True">
                                                <Setter Property="Background" Value="#FFD600" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource Style.PanelButton}" Width="16" Height="14" Margin="2,0,0,0" Background="Transparent"
                            Click="OnCloseClick" ToolTip="{Binding QuickPanelCloseToolTip}">
                        <Button.InputBindings>
                            <MouseBinding Gesture="RightClick" Command="{Binding ToggleQuickPanelReopenCommand}" />
                        </Button.InputBindings>
                        <Path Data="M0,0 L8,8 M8,0 L0,8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{StaticResource Brush.TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QuickPanelReopenOnFinish}" Value="True">
                                            <Setter Property="Stroke" Value="#00C853" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
            <Grid>
                <TextBlock Text="Нет таймеров для панели.&#x0a;Включите их в окне «Быстрые таймеры»." TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,6" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPanelTimers}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                    <ItemsControl ItemsSource="{Binding PanelTimers}" Focusable="False" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Фон строки и эффекты хода «заливка»/«убывающая заливка» -->
                                    <Border CornerRadius="9" Background="{StaticResource Brush.ButtonSurface}" Opacity="0.5" />
                                    <Border x:Name="FillBar" CornerRadius="9" Background="{Binding Color}" Opacity="0.4" Visibility="Collapsed"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}" /></Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="DrainBar" CornerRadius="9" Background="{Binding Color}" Opacity="0.4" Visibility="Collapsed"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding RemainingFraction}" /></Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="FlashBg" CornerRadius="9" Background="{Binding FinishColor}" Opacity="0" IsHitTestVisible="False" />

                                    <Grid x:Name="RowContent" Margin="5,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PanelName" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PanelTime" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Плей/пауза и под ней сброс -->
                                        <StackPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource Style.PanelButton}" Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayToolTip}">
                                                <Viewbox Width="9" Height="9">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{Binding IsRunning, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.Pause|Geometry.Play}"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Style="{StaticResource Style.PanelButton}" Command="{Binding ResetCommand}" Margin="0,1,0,0"
                                                    ToolTip="Клик ЛКМ — сброс (время таймера заново)">
                                                <Viewbox Width="9" Height="9">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource Geometry.Refresh}"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                        <!-- Имя: цвет и начертание как у часов (в сегментном шрифте часов нет букв — обычный шрифт) -->
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding FullName}" Margin="8,0,14,0" VerticalAlignment="Center"
                                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding GhostText}" Style="{StaticResource Style.SegmentGhost}" FontSize="18" />
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Style.SegmentDigits}" FontSize="18" />
                                            <TextBlock x:Name="PulseText" Text="{Binding TimeText}" Style="{StaticResource Style.SegmentDigits}" FontSize="18"
                                                       Foreground="{Binding FinishColor}" Opacity="0" />
                                        </Grid>
                                    </Grid>

                                    <!-- «полоска под строкой» и «деления под строкой» -->
                                    <Border x:Name="LineTrack" Grid.Row="1" Height="3" Margin="8,3,8,0" CornerRadius="1.5" Visibility="Collapsed"
                                            Background="{StaticResource Brush.BorderSubtle}">
                                        <Border Background="{Binding Color}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}" /></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <ItemsControl x:Name="SegmentTrack" Grid.Row="1" Margin="7,3,7,0" Visibility="Collapsed" ItemsSource="{Binding Segments}"
                                                  Tag="{Binding Color}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="3" Margin="1,0" CornerRadius="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Brush.BorderSubtle}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLit}" Value="True">
                                                                    <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Progress}" Value="{x:Static m:QuickPanelProgress.Fill}">
                                        <Setter TargetName="FillBar" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Progress}" Value="{x:Static m:QuickPanelProgress.Drain}">
                                        <Setter TargetName="DrainBar" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Progress}" Value="{x:Static m:QuickPanelProgress.Line}">
                                        <Setter TargetName="LineTrack" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Progress}" Value="{x:Static m:QuickPanelProgress.Segments}">
                                        <Setter TargetName="SegmentTrack" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- Эффекты окончания: пока таймер «закончился» (длительность — общая «Длительность эффекта») -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEffectActive}" Value="True" />
                                            <Condition Binding="{Binding Finish}" Value="{x:Static m:QuickPanelFinish.Blink}" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="BlinkStory">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RowContent" Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.15" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="PulseText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="BlinkStory" /></MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEffectActive}" Value="True" />
                                            <Condition Binding="{Binding Finish}" Value="{x:Static m:QuickPanelFinish.Flash}" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="FlashStory">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="FlashBg" Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="0.75" Duration="0:0:0.35" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="FlashStory" /></MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEffectActive}" Value="True" />
                                            <Condition Binding="{Binding Finish}" Value="{x:Static m:QuickPanelFinish.Pulse}" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="PulseStory">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="PulseText" Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PulseStory" /></MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </Grid>
            </StackPanel>
        </Border>
    </Border>
</Window>
