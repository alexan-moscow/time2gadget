<Window x:Class="Time2Gadget.Views.QuickTimersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Time2Gadget.Controls"
        xmlns:vm="clr-namespace:Time2Gadget.ViewModels"
        Title="Быстрые таймеры — Тайм2гаджет"
        Width="650" SizeToContent="Height" MinWidth="630" PreviewMouseDown="OnWindowPreviewMouseDown"
        Background="{StaticResource Brush.Background}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">
    <!-- Докладка 2026-10-01: раздел «Быстрые таймеры» из настроек — отдельным окном (привязка — MainViewModel, как в настройках). -->
    <Window.Resources>
        <!-- Щелчок по пункту меню — выбрать и закрыть меню (кнопка ▶ внутри пункта сюда не относится). -->
        <Style x:Key="Style.QuickSoundItem" TargetType="ListBoxItem" BasedOn="{StaticResource Style.SoundListItem}">
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnQuickSoundItemClick" />
        </Style>
        <Style x:Key="Style.QuickEffectItem" TargetType="ListBoxItem" BasedOn="{StaticResource Style.SoundListItem}">
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnQuickEffectItemClick" />
        </Style>
        <!-- Название эффекта в списке: не помещается — сокращается «…» (полное — в подсказке и в раскрытом списке). -->
        <DataTemplate x:Key="EffectName">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" VerticalAlignment="Center" />
                <!-- ▶/■ — только в раскрытом списке (в поле выбора кнопки нет): показ этого таймера в виджете с эффектом; цвет значка — выбранный цвет эффекта (Tint пункта) -->
                <Button Grid.Column="1" Padding="6,0" FontSize="10" Margin="8,0,0,0" Foreground="{Binding Tint}"
                        PreviewMouseLeftButtonDown="OnPanelEffectPreviewMouseDown" PreviewMouseLeftButtonUp="OnRingtonePreviewMouseUp">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Style.PreviewButton}">
                            <Setter Property="ToolTip" Value="Клик ЛКМ — показать этот таймер в виджете с эффектом" />
                            <!-- значок фигурой: символы ▶/■ шрифт рисует своими цветами, а нужен выбранный цвет эффекта -->
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Viewbox Width="10" Height="10">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.Stop|Geometry.Play}" />
                                            </Canvas>
                                        </Viewbox>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="ToolTip" Value="Клик ЛКМ — остановить показ" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanPreview}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue={x:Null}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>
        <!-- Образец цвета в палитре: команда выбора — в Tag списка (палитры хода и окончания). -->
        <DataTemplate x:Key="PanelSwatch">
            <Button Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Margin="2" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch" Width="22" Height="22" CornerRadius="3" Background="{Binding Hex}"
                                BorderThickness="1" BorderBrush="{StaticResource Brush.BorderSubtle}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
        <!-- Мини-кнопки строки (плей/пауза над сбросом) — как в виджете быстрых таймеров. -->
        <Style x:Key="Style.MiniButton" TargetType="Button" BasedOn="{StaticResource Style.RectButton}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceSectorHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Прокрутка как в остальных окнах: полоса у правого края окна. -->
    <ScrollViewer Margin="20,16,0,16" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
        <StackPanel>
            <TextBlock Text="Быстрые таймеры" Style="{StaticResource Style.SectionHeader}" Margin="0,0,0,8" />
            <!-- Подписи столбцов (докладка 2026-10-01: имя и дни) -->
            <Grid Margin="0,0,0,2" TextElement.FontSize="11" TextElement.Foreground="{StaticResource Brush.TextSecondary}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128" /><ColumnDefinition Width="30" /><ColumnDefinition Width="30" /><ColumnDefinition Width="30" />
                    <ColumnDefinition Width="30" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Имя" Margin="24,0,0,0" />
                <TextBlock Grid.Column="1" Text="дни" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="час" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="мин" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="сек" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="Клавиша (запускает главный таймер)" Margin="6,0,0,0" />
            </Grid>
            <ItemsControl ItemsSource="{Binding QuickTimers}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Плей/пауза над сбросом: таймер виджета — в виджете, иначе — главный таймер -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Button Style="{StaticResource Style.MiniButton}" Command="{Binding RowPlayCommand}" ToolTip="{Binding RowPlayToolTip}">
                                    <Viewbox Width="7" Height="7">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{Binding RowIsRunning, Converter={StaticResource BoolToGeometry}, ConverterParameter=Geometry.Pause|Geometry.Play}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource Style.MiniButton}" Command="{Binding RowResetCommand}" ToolTip="{Binding RowResetToolTip}" Margin="0,2,0,0">
                                    <Viewbox Width="7" Height="7">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource Geometry.Refresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding Name}" Height="24" Tag="TimerName" KeyDown="OnNameKeyDown" VerticalContentAlignment="Center" MaxLength="24"
                                     ToolTip="Имя таймера — так он называется в виджете и в предупреждениях" />
                            <c:TimeSpinner Grid.Column="2" Height="24" Maximum="99" Value="{Binding Days}" ToolTip="Дни" Margin="4,0,0,0" />
                            <c:TimeSpinner Grid.Column="3" Height="24" Maximum="23" Value="{Binding Hours}" ToolTip="Часы" Margin="2,0,0,0" />
                            <c:TimeSpinner Grid.Column="4" Height="24" Value="{Binding Minutes}" ToolTip="Минуты" Margin="2,0,0,0" />
                            <c:TimeSpinner Grid.Column="5" Height="24" Value="{Binding Seconds}" ToolTip="Секунды" Margin="2,0,0,0" />
                            <c:HotkeyBox Grid.Column="6" BindingValue="{Binding Binding}" Margin="4,0,0,0" />

                            <!-- В панели быстрых таймеров: переключатель левее кнопки эффекта (подсвечен — показывается) -->
                            <Button x:Name="PanelButton" Grid.Column="7" Margin="4,0,0,0" Style="{StaticResource Style.RowIconButton}"
                                    Command="{Binding TogglePanelCommand}" ToolTip="{Binding PanelToolTip}">
                                <Button.InputBindings>
                                    <MouseBinding Gesture="RightClick" Command="{Binding PermanentPanelCommand}" />
                                </Button.InputBindings>
                                <Grid Width="14" Height="12">
                                    <Rectangle x:Name="PanelFrame" RadiusX="2" RadiusY="2" StrokeThickness="1.2" Stroke="{StaticResource Brush.TextSecondary}" />
                                    <Path x:Name="PanelLines" Data="M3,4 L11,4 M3,8 L8,8" StrokeThickness="1.4" Stroke="{StaticResource Brush.TextSecondary}" />
                                </Grid>
                            </Button>

                            <!-- Эффект завершения таймера: иконка текущего эффекта («—» нет), меню с просмотром. -->
                            <Button x:Name="EffectButton" Grid.Column="8" Margin="4,0,0,0" Style="{StaticResource Style.RowIconButton}"
                                    Command="{Binding EffectCommand}" ToolTip="{Binding EffectToolTip}" IsEnabled="{Binding MainEffectEnabled}" ToolTipService.ShowOnDisabled="True">
                                <ContentControl Content="{Binding FinishEffect, Converter={StaticResource EffectIcon}}" Focusable="False" />
                            </Button>
                            <Popup Grid.Column="8" PlacementTarget="{Binding ElementName=EffectButton}" Placement="Bottom" HorizontalOffset="-150"
                                   StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsEffectMenuOpen, Mode=TwoWay}"
                                   Closed="OnQuickEffectPopupClosed">
                                <Border Width="190" Style="{StaticResource Style.MenuBorder}">
                                    <ListBox ItemsSource="{Binding EffectOptions}" SelectedValuePath="Value" SelectedValue="{Binding FinishEffect, Mode=OneWay}"
                                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Style.QuickEffectItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl Content="{Binding Value, Converter={StaticResource EffectIcon}}" Focusable="False"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Style="{StaticResource Style.EffectPreviewButton}" Padding="6,0" FontSize="10"
                                                            Visibility="{Binding CanPreview, Converter={StaticResource BoolToVis}}"
                                                            PreviewMouseLeftButtonDown="OnEffectPreviewMouseDown"
                                                            PreviewMouseLeftButtonUp="OnRingtonePreviewMouseUp" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>

                            <!-- Звук: включён — колокольчик синий, щелчок выключает; выключен — перечёркнут, щелчок открывает меню. -->
                            <Button x:Name="SoundButton" Grid.Column="9" Margin="4,0,0,0" Style="{StaticResource Style.RowIconButton}"
                                    Command="{Binding BellCommand}" ToolTip="{Binding SoundToolTip}">
                                <Grid Width="12" Height="12">
                                    <Path x:Name="Bell" Stretch="Uniform" StrokeThickness="1.2"
                                          Data="M6,0.8 C3.9,0.8 2.6,2.4 2.6,4.6 L2.6,7.4 L1.2,9.2 L10.8,9.2 L9.4,7.4 L9.4,4.6 C9.4,2.4 8.1,0.8 6,0.8 Z M4.4,10 A1.6,1.6 0 0 0 7.6,10 Z"
                                          Stroke="{StaticResource Brush.TextSecondary}" Fill="Transparent" />
                                    <Path x:Name="BellSlash" Data="M0.5,11.5 L11.5,0.5" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.4" />
                                </Grid>
                            </Button>
                            <Popup Grid.Column="9" PlacementTarget="{Binding ElementName=SoundButton}" Placement="Bottom" HorizontalOffset="-230"
                                   StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsSoundMenuOpen, Mode=TwoWay}"
                                   Closed="OnQuickSoundPopupClosed">
                                <Border Width="260" Style="{StaticResource Style.MenuBorder}">
                                    <StackPanel>
                                        <!-- Громкость: «общая» — из раздела «Звук»; тронули ползунок — галочка снимается сама. -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Громкость" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" Content="общая" IsChecked="{Binding UseGeneralVolume}" Margin="8,0,0,0"
                                                      VerticalAlignment="Center" ToolTip="Громкость как в разделе «Звук»" />
                                            <Slider ToolTip="Своя громкость этого таймера (снимает «общая»)" Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding VolumeValue}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1" />
                                        </Grid>
                                        <!-- Щелчок по звонку — выбрать, включить звук и закрыть меню. -->
                                        <ListBox ItemsSource="{Binding SoundOptions}" SelectedValuePath="Id" SelectedValue="{Binding RingtoneKey}"
                                                 Height="200" Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource Style.QuickSoundItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Visibility="{Binding CanPreview, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource Style.SoundDuration}" />
                                                            <Button Style="{StaticResource Style.PreviewButton}" Tag="{Binding Id}" Padding="6,0" FontSize="10"
                                                                    PreviewMouseLeftButtonDown="OnQuickSoundPreviewMouseDown"
                                                                    PreviewMouseLeftButtonUp="OnRingtonePreviewMouseUp" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <!-- Свой файл таймера: копия в папке звуков программы. -->
                                        <Grid Margin="0,6,0,0" Visibility="{Binding IsCustomFileSelected, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button ToolTip="Выбрать другой файл для этого таймера" Content="Обзор" Command="{Binding BrowseSoundCommand}" Style="{StaticResource Style.SettingsButton}"
                                                    Padding="8,2" Margin="0" />
                                            <TextBlock Grid.Column="1" Text="{Binding CustomFileName}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding CustomFileName}" />
                                        </Grid>
                                        <TextBlock Text="Устройство" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,8,0,4" />
                                        <ComboBox ToolTip="Куда выводить звонок этого таймера" ItemsSource="{Binding DeviceOptions}" DisplayMemberPath="FriendlyName"
                                                  SelectedValuePath="Id" SelectedValue="{Binding DeviceKey}" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- Действие после окончания: между колокольчиком и «×» -->
                            <Button x:Name="AfterButton" Grid.Column="10" Margin="4,0,0,0" Style="{StaticResource Style.RowIconButton}"
                                    Command="{Binding AfterCommand}" ToolTip="{Binding AfterToolTip}">
                                <Viewbox Width="12" Height="12">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="AfterIcon" Data="{StaticResource Geometry.Power}" Fill="{StaticResource Brush.TextSecondary}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Popup Grid.Column="10" PlacementTarget="{Binding ElementName=AfterButton}" Placement="Bottom" HorizontalOffset="-250"
                                   StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsAfterMenuOpen, Mode=TwoWay}">
                                <Border Width="280" Style="{StaticResource Style.MenuBorder}">
                                    <StackPanel>
                                        <TextBlock Text="После окончания — когда отыграют эффект и звук:" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6" />
                                        <ListBox ItemsSource="{x:Static vm:QuickTimerItem.AfterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                 SelectedValue="{Binding AfterAction}" Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource Style.SoundListItem}" />
                                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding AfterTargets}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectedValue="{Binding AfterTimerId}" ToolTip="Какой быстрый таймер запустить"
                                                  Visibility="{Binding IsAfterStartTimer, Converter={StaticResource BoolToVis}}" />
                                        <!-- открыть: путь или ссылка + «Обзор» -->
                                        <Grid Margin="0,6,0,0" Visibility="{Binding IsAfterOpen, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding AfterOpenTarget, UpdateSourceTrigger=PropertyChanged, Delay=400}" Height="24" VerticalContentAlignment="Center"
                                                     ToolTip="Путь к файлу или программе, или ссылка (https://…)" />
                                            <Button Grid.Column="1" Content="Обзор" Command="{Binding BrowseOpenCommand}" Style="{StaticResource Style.SettingsButton}"
                                                    Padding="8,2" Margin="4,0,0,0" ToolTip="Клик ЛКМ — выбрать файл или программу" />
                                        </Grid>
                                        <!-- сообщение: текст, положение, фон, размер шрифта -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsAfterMessage, Converter={StaticResource BoolToVis}}">
                                            <TextBox Text="{Binding AfterMessageText, UpdateSourceTrigger=PropertyChanged, Delay=400}" Height="48" TextWrapping="Wrap"
                                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                     ToolTip="Текст сообщения; пусто — «Таймер «имя» закончился»" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Положение" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0" />
                                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:QuickTimerItem.MessagePositions}" DisplayMemberPath="Label"
                                                          SelectedValuePath="Value" SelectedValue="{Binding AfterMessagePosition}" />
                                            </Grid>
                                            <TextBlock Text="Фон" FontSize="11" Margin="0,6,0,2" />
                                            <ItemsControl x:Name="MessagePalette" ItemsSource="{x:Static vm:MonitorFitItem.BasicColors}" Tag="{Binding ChooseMessageColorCommand}"
                                                          ItemTemplate="{StaticResource PanelSwatch}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <TextBlock FontSize="11" Margin="0,6,0,2">
                                                <Run Text="Размер шрифта:" /> <Run Text="{Binding AfterMessageFontSize, Mode=OneWay}" />
                                            </TextBlock>
                                            <Slider Minimum="16" Maximum="200" Value="{Binding AfterMessageFontSize}" SmallChange="2" LargeChange="10" />
                                            <Button Content="Показать" Command="{Binding ShowMessageCommand}" Style="{StaticResource Style.SettingsButton}" HorizontalAlignment="Left"
                                                    Margin="0,6,0,0" ToolTip="Клик ЛКМ — показать сообщение сейчас (закрыть — клик или любая клавиша)" />
                                        </StackPanel>
                                        <TextBlock Text="Через 30 секунд, Windows предупредит. Передумали — Win+R, shutdown /a" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource Brush.UpdateAccent}" Margin="0,6,0,0"
                                                   Visibility="{Binding IsAfterPower, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="Сброс таймера до этого момента действие отменяет." TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Button Grid.Column="11" Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource Style.SettingsButton}"
                                    Width="22" Height="24" Padding="0" Margin="4,0,0,0" ToolTip="Удалить таймер" />
                        </Grid>
                        <!-- Настройки панели — под строкой, пока таймер в панели -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,4" Visibility="{Binding ShowInPanel, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="В виджете:" VerticalAlignment="Center" Width="124" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                            <ComboBox Width="150" Margin="4,0,0,0" ItemsSource="{Binding ProgressOptions}" ItemTemplate="{StaticResource EffectName}" Tag="{Binding PanelColor}" DropDownClosed="OnPanelEffectDropDownClosed"
                                      SelectedValuePath="Value" SelectedValue="{Binding PanelProgress}" ToolTip="Ход таймера в виджете (заливки и полоски видны всегда, остальные эффекты — пока таймер работает)" />
                            <Button x:Name="PanelColorButton" Margin="4,0,0,0" Style="{StaticResource Style.RowIconButton}"
                                    Command="{Binding OpenColorMenuCommand}" ToolTip="{Binding ColorToolTip}" IsEnabled="{Binding ProgressColorEnabled}" ToolTipService.ShowOnDisabled="True">
                                <Border Width="14" Height="14" CornerRadius="2" Background="{Binding PanelColor}" />
                            </Button>
                            <Popup PlacementTarget="{Binding ElementName=PanelColorButton}" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" IsOpen="{Binding IsColorMenuOpen, Mode=TwoWay}">
                                <Border x:Name="PanelPalette" Style="{StaticResource Style.MenuBorder}" Padding="6">
                                    <ItemsControl ItemsSource="{x:Static vm:QuickTimerItem.PanelColors}" ItemTemplate="{StaticResource PanelSwatch}"
                                                  Tag="{Binding ChooseColorCommand}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                            <ComboBox Width="136" Margin="12,0,0,0" ItemsSource="{Binding FinishOptions}" ItemTemplate="{StaticResource EffectName}" Tag="{Binding PanelFinishColor}" DropDownClosed="OnPanelEffectDropDownClosed"
                                      SelectedValuePath="Value" SelectedValue="{Binding PanelFinish}" ToolTip="Эффект окончания в виджете" />
                            <Button x:Name="FinishColorButton" Margin="4,0,0,0" Style="{StaticResource Style.RowIconButton}"
                                    Command="{Binding OpenFinishColorMenuCommand}" ToolTip="{Binding FinishColorToolTip}" IsEnabled="{Binding FinishColorEnabled}" ToolTipService.ShowOnDisabled="True">
                                <Border Width="14" Height="14" CornerRadius="2" Background="{Binding PanelFinishColor}" />
                            </Button>                            <Popup PlacementTarget="{Binding ElementName=FinishColorButton}" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" IsOpen="{Binding IsFinishColorMenuOpen, Mode=TwoWay}">
                                <Border x:Name="FinishPalette" Style="{StaticResource Style.MenuBorder}" Padding="6">
                                    <ItemsControl ItemsSource="{x:Static vm:QuickTimerItem.PanelColors}" ItemTemplate="{StaticResource PanelSwatch}"
                                                  Tag="{Binding ChooseFinishColorCommand}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </Popup>                            <c:TimeSpinner Height="24" Width="30" Maximum="20" Value="{Binding PanelFinishSeconds}" Margin="4,0,0,0"
                                           ToolTip="Сколько секунд длится эффект окончания в виджете (до 20)" />
                            <TextBlock Text="с" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding ShowInPanel}" Value="True">
                                <Setter TargetName="PanelFrame" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="PanelLines" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPanelPermanentShown}" Value="True">
                                <Setter TargetName="PanelFrame" Property="Stroke" Value="#FF9100" />
                                <Setter TargetName="PanelLines" Property="Stroke" Value="#FF9100" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsColorMenuOpen}" Value="True">
                                <Setter TargetName="PanelColorButton" Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasAfterAction}" Value="True">
                                <Setter TargetName="AfterIcon" Property="Fill" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAfterMenuOpen}" Value="True">
                                <Setter TargetName="AfterButton" Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MainEffectEnabled}" Value="False">
                                <Setter TargetName="EffectButton" Property="Opacity" Value="0.3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProgressColorEnabled}" Value="False">
                                <Setter TargetName="PanelColorButton" Property="Opacity" Value="0.3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FinishColorEnabled}" Value="False">
                                <Setter TargetName="FinishColorButton" Property="Opacity" Value="0.3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFinishColorMenuOpen}" Value="True">
                                <Setter TargetName="FinishColorButton" Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SoundEnabled}" Value="True">
                                <Setter TargetName="Bell" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Bell" Property="Fill" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="BellSlash" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSoundMenuOpen}" Value="True">
                                <Setter TargetName="SoundButton" Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEffectMenuOpen}" Value="True">
                                <Setter TargetName="EffectButton" Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button ToolTip="Добавить быстрый таймер (до 5)" Content="+ Добавить таймер" Command="{Binding AddQuickTimerCommand}" Style="{StaticResource Style.SettingsButton}"
                    HorizontalAlignment="Left" Margin="0,6,0,0"
                    Visibility="{Binding CanAddQuickTimer, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="Значок левее эффекта: не горит — клавиша запускает главный таймер (компакт и полный вид). Синий (клик ЛКМ) — таймер виджета: клавиша запускает его в виджете, а после окончания он пропадает до следующего запуска. Оранжевый (клик ПКМ) — всегда в виджете. Кнопки перед именем — запуск / пауза и сброс. Главный таймер считает не больше суток. Колокольчик — свой звонок и устройство."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding QuickTimersWarning}" Style="{StaticResource Style.HotkeyWarning}" />

            <!-- Виджет быстрых таймеров (докладка 2026-10-01) -->
            <TextBlock Text="Виджет быстрых таймеров" Style="{StaticResource Style.SectionHeader}" Margin="0,16,0,6" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Показать / скрыть виджет" Command="{Binding ToggleQuickPanelCommand}" Style="{StaticResource Style.SettingsButton}"
                            Margin="0" ToolTip="Клик ЛКМ — показать или скрыть виджет" />
                    <Button Content="Сброс положения" Click="OnResetWidgetPosition" Style="{StaticResource Style.SettingsButton}" Margin="6,0,0,0"
                            ToolTip="Клик ЛКМ — показать виджет по центру монитора, на котором это окно" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding QuickPanelScaleLabel}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                    <Slider Minimum="0.6" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding QuickPanelScale}"
                            ToolTip="Размер виджета быстрых таймеров (то же — в настройках, раздел «Размер»)" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Сортировать таймеры:" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox Margin="8,0,0,0" Width="232" ItemsSource="{Binding QuickPanelSortOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding QuickPanelSort}"
                              ToolTip="Порядок таймеров в виджете" />
                    <CheckBox Content="меню по ПКМ на виджете" IsChecked="{Binding QuickPanelSortMenu}" Margin="10,0,0,0" VerticalAlignment="Center"
                              ToolTip="Клик ПКМ по виджету открывает эти же настройки сортировки (на кнопках заголовка — не открывает)" />
                </StackPanel>
            </Grid>
            <CheckBox Content="Сокращать размер виджета под количество активных таймеров" IsChecked="{Binding QuickPanelShrink}" Margin="0,8,0,0"
                      ToolTip="Включено — высота по работающим таймерам (нет таймеров — только заголовок), место виджета не меняется.&#x0a;Выключено — высота под все синие и оранжевые таймеры, пустое место — надпись «нет активных быстрых таймеров».&#x0a;Ширина — всегда по самому длинному имени и времени синих и оранжевых таймеров" />
            <CheckBox Content="Быстрое управление кликами по таймеру" IsChecked="{Binding QuickPanelClickControl}" Margin="0,6,0,0"
                      IsEnabled="{Binding QuickPanelClickControlAvailable}" ToolTipService.ShowOnDisabled="True"
                      ToolTip="Клик ЛКМ по таймеру — запуск / пауза, клик ПКМ по работающему таймеру — сброс.&#x0a;Доступно, когда выключено «меню по ПКМ на виджете»" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="22,2,0,0"
                       Text="Клик ЛКМ по таймеру — запуск / пауза, клик ПКМ по работающему таймеру — сброс. Работает, когда выключено «меню по ПКМ на виджете»." />
            <CheckBox Content="Виджет поверх всех окон" IsChecked="{Binding QuickPanelTopmost}" Margin="0,6,0,0"
                      ToolTip="То же, что клик ЛКМ по кнопке в заголовке виджета (верхняя половина значка — зелёная). Не зависит от «поверх всех окон» главного окна" />
            <TextBlock Text="Таймеры виджета работают отдельно от главного. В заголовке виджета: значок — клик ЛКМ «поверх всех окон», клик ПКМ «закрепить»; крестик — клик ЛКМ закрыть, клик ПКМ открывать виджет снова, когда таймер закончится."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,6,0,0" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                <CheckBox Content="Вкл/выкл виджет" IsChecked="{Binding QuickPanelHotkeyEnabled}" VerticalAlignment="Center"
                          ToolTip="Сочетание справа включает и выключает виджет из любой программы" />
                <c:HotkeyBox Grid.Column="1" BindingValue="{Binding QuickPanelKeyShown}" IsEnabled="{Binding QuickPanelHotkeyEnabled}"
                             ToolTip="Сочетание для виджета. Клик ЛКМ — назначить другое" />
            </Grid>

            <!-- Быстрое открытие этого окна глобальной клавишей (по умолчанию выкл; то же — в «Настройке клавиш»). -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                <CheckBox Content="Быстрое открытие этого окна" IsChecked="{Binding QuickTimersWindowHotkeyEnabled}" VerticalAlignment="Center"
                          ToolTip="Сочетание справа открывает это окно из любой программы" />
                <c:HotkeyBox Grid.Column="1" BindingValue="{Binding QuickTimersWindowKeyShown}" IsEnabled="{Binding QuickTimersWindowHotkeyEnabled}"
                             ToolTip="Сочетание для открытия этого окна. Клик ЛКМ — назначить другое" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
