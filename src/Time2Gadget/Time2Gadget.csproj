<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Только для системного трея (NotifyIcon) — docs/DECISIONS.md, 2026-09-26. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Time2Gadget</AssemblyName>
    <RootNamespace>Time2Gadget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Версия приложения — её же получает установщик Velopack (vpk pack packVersion); повышать при каждом выпуске. -->
    <Version>1.0.2</Version>
    <!-- Своя точка входа (Program.cs): Velopack должен отработать до старта WPF — docs/DECISIONS.md, 2026-09-27. -->
    <StartupObject>Time2Gadget.Program</StartupObject>
    <!-- Portable single-file публикация (docs/ARCHITECTURE.md → Packaging). -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- UseWindowsForms добавляет глобальные implicit usings System.Windows.Forms/System.Drawing,
       которые конфликтуют с WPF-типами (Point/UserControl/Application) проектно-широко.
       WinForms нужен только в Services/TrayService.cs, где уже есть явный using — см.
       docs/DECISIONS.md, 2026-09-26. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <!-- Месяц/год сборки для «Об авторе» (MainViewModel.AuthorLine) — проставляется автоматически при каждой сборке. -->
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM'))" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>
  <!-- Сегментный шрифт циферблата DSEG7 (SIL OFL 1.1, Assets/Fonts/DSEG-LICENSE.txt) — docs/DECISIONS.md, 2026-09-27. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <!-- Встроенные звонки (mp3 с Pixabay, выбраны пользователем) — Models/RingtoneCatalog.cs. Имя ресурса = Ringtones.{id}.mp3. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Ringtones\*.mp3" LogicalName="Ringtones.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
