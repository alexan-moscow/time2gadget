<Application x:Class="Time2Gadget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Time2Gadget"
             xmlns:conv="clr-namespace:Time2Gadget.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:TimeSpanToStringConverter x:Key="TimeSpanConverter" />            <conv:BoolToGeometryConverter x:Key="BoolToGeometry" />
            <conv:RingtonePreviewVisibilityConverter x:Key="RingtonePreviewVisibility" />
            <conv:EffectIconConverter x:Key="EffectIcon" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
